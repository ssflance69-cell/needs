---
// Floating Contact Action Bar for Mobile & Tablet
---

<div class="fixed bottom-4 right-4 z-40 flex items-center gap-2 sm:hidden">
  <!-- Call Button -->
  <button
    type="button"
    data-open-call
    class="flex items-center justify-center w-12 h-12 rounded-full bg-white/95 text-zinc-800 border border-zinc-200 shadow-lg backdrop-blur-md active:scale-95 transition-all focus:outline-none focus:ring-2 focus:ring-amber-500"
    aria-label="Direct Phone Call"
  >
    <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
    </svg>
  </button>

  <!-- WhatsApp Button with Pulsing Wave Indicator -->
  <button
    type="button"
    data-open-whatsapp
    class="relative flex items-center justify-center h-12 px-4 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white shadow-xl active:scale-95 transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500"
    aria-label="Chat on WhatsApp"
  >
    <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-400 border-2 border-white"></span>
    </span>
    <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
    </svg>
    <span class="ml-1.5 text-xs font-semibold tracking-wide">WhatsApp</span>
  </button>
</div>