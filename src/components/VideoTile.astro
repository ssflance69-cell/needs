---
import type { ProjectMediaItem } from '../data/media';

interface Props {
  item: ProjectMediaItem;
}

const { item } = Astro.props;
---

<div
  class="group relative rounded-2xl overflow-hidden bg-white border border-zinc-200 hover:border-amber-500/70 transition-all duration-300 shadow-sm hover:shadow-xl cursor-pointer"
  data-lightbox-trigger
  data-type="video"
  data-video-mp4={item.videoSources?.mp4}
  data-video-webm={item.videoSources?.webm}
  data-title={item.title}
  data-description={item.description}
  data-location={item.location}
>
  <!-- Facade Poster (Click-to-Load: Zero video payload until user clicks) -->
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-zinc-100">
    <img
      src={item.image}
      alt={item.alt}
      width="1280"
      height="720"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></div>

    <!-- Play Icon Button Badge -->
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="w-14 h-14 rounded-full bg-amber-700 text-white flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:bg-amber-600 transition-all duration-300">
        <svg class="w-6 h-6 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
      </div>
    </div>

    <!-- Top Category Tag -->
    <div class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-white/90 backdrop-blur-md border border-zinc-200 text-[10px] font-bold tracking-wider uppercase text-amber-900 font-mono shadow-sm">
      Video • {item.category}
    </div>

    <!-- Location Pill -->
    <div class="absolute bottom-3 left-3 px-2 py-0.5 rounded bg-black/60 backdrop-blur-sm text-[11px] text-white flex items-center gap-1.5 font-mono">
      <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span>{item.location}</span>
    </div>
  </div>

  <!-- Meta Info -->
  <div class="p-5 space-y-1.5">
    <h3 class="text-base font-bold text-zinc-900 group-hover:text-amber-800 transition-colors font-heading line-clamp-1">
      {item.title}
    </h3>
    <p class="text-xs text-zinc-600 line-clamp-2 leading-relaxed">
      {item.description}
    </p>
  </div>
</div>