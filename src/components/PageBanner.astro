---
import type { MediaVideoSource } from '../data/media';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle: string;
  badge?: string;
  video: MediaVideoSource;
  breadcrumbs?: BreadcrumbItem[];
  serviceName?: string;
}

const {
  title,
  subtitle,
  video,
  breadcrumbs = [],
  serviceName,
} = Astro.props;
---

<!-- Dedicated Clean Breadcrumb Bar (Standard Live Architecture & Corporate Website Pattern) -->
{breadcrumbs.length > 0 && (
  <nav aria-label="Breadcrumb" class="bg-zinc-100 border-b border-zinc-200/90 py-2 sm:py-2.5 text-xs text-zinc-500 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center gap-2">
        <li>
          <a href="/" class="hover:text-amber-800 transition-colors">Home</a>
        </li>
        {breadcrumbs.map((crumb) => (
          <li class="flex items-center gap-2">
            <span class="text-zinc-400">/</span>
            {crumb.href ? (
              <a href={crumb.href} class="hover:text-amber-800 transition-colors">
                {crumb.label}
              </a>
            ) : (
              <span class="text-zinc-800 font-medium" aria-current="page">
                {crumb.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}

<!-- Clean, Compact Page Header Strip (Zero AI Pill Badges) -->
<section class="relative w-full overflow-hidden bg-zinc-950 text-white border-b border-zinc-800">
  <!-- Subtle Ambient Background -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
    <video
      class="w-full h-full object-cover opacity-25"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster={video.poster}
      aria-hidden="true"
    >
      <source src={video.mp4} type="video/mp4" />
      {video.webm && <source src={video.webm} type="video/webm" />}
    </video>
  </div>

  <div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/90 to-zinc-950/75 z-0"></div>

  <!-- Compact Content Strip -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-7 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5">
      <div class="space-y-1.5 max-w-3xl">
        <!-- Main Heading -->
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight font-heading leading-tight">
          {title}
        </h1>

        <!-- Subtitle -->
        <p class="text-xs sm:text-sm text-zinc-300 max-w-2xl leading-relaxed">
          {subtitle}
        </p>
      </div>

      <!-- Quick Action CTAs -->
      <div class="flex items-center gap-2.5 shrink-0 pt-1 lg:pt-0">
        <button
          type="button"
          data-open-whatsapp
          data-service={serviceName || title}
          class="inline-flex items-center gap-2 px-4 sm:px-5 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
          <span>WhatsApp Estimate</span>
        </button>

        <button
          type="button"
          data-open-call
          class="inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white hover:text-amber-300 border border-white/20 font-semibold text-xs uppercase tracking-wider backdrop-blur-sm transition-all"
        >
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>Call Fabricator</span>
        </button>
      </div>
    </div>
  </div>
</section>
