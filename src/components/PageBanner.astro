---
import type { MediaVideoSource } from '../data/media';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle: string;
  badge?: string;
  video: MediaVideoSource;
  breadcrumbs?: BreadcrumbItem[];
  serviceName?: string;
}

const {
  title,
  subtitle,
  badge = 'NEEDS GROUP SURATHKAL',
  video,
  breadcrumbs = [],
  serviceName,
} = Astro.props;
---

<section class="relative w-full overflow-hidden bg-zinc-950 text-white min-h-[380px] sm:min-h-[420px] lg:min-h-[460px] flex items-center border-b border-zinc-800">
  <!-- Panoramic Ambient Video/Poster Background -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
    <video
      class="w-full h-full object-cover opacity-50 sm:opacity-40"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster={video.poster}
      aria-hidden="true"
    >
      <source src={video.mp4} type="video/mp4" />
      {video.webm && <source src={video.webm} type="video/webm" />}
    </video>
  </div>

  <!-- Deep Architectural Gradient Scrim for Flawless Text Legibility -->
  <div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/85 to-zinc-950/60 z-0"></div>
  <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-zinc-950 to-transparent z-0"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_80%_30%,rgba(180,83,9,0.12),transparent_70%)] pointer-events-none z-0"></div>

  <!-- Main Content Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24 relative z-10 w-full">
    <div class="max-w-3xl space-y-5">
      <!-- Breadcrumb navigation -->
      {breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2 text-xs text-zinc-400">
            <li>
              <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
            </li>
            {breadcrumbs.map((crumb) => (
              <li class="flex items-center gap-2">
                <span class="text-zinc-600">/</span>
                {crumb.href ? (
                  <a href={crumb.href} class="hover:text-amber-400 transition-colors">
                    {crumb.label}
                  </a>
                ) : (
                  <span class="text-amber-300 font-medium" aria-current="page">
                    {crumb.label}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}

      <!-- Clean Category Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-400/30 text-amber-300 text-xs font-semibold tracking-wider uppercase shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        {badge}
      </div>

      <!-- Main Heading (Crisp high-contrast architectural typography) -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-heading leading-tight drop-shadow-sm">
        {title}
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-zinc-300 max-w-2xl leading-relaxed">
        {subtitle}
      </p>

      <!-- Quick Action CTAs -->
      <div class="pt-3 flex flex-wrap items-center gap-3.5">
        <button
          type="button"
          data-open-whatsapp
          data-service={serviceName || title}
          class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] text-white font-bold text-xs uppercase tracking-wider shadow-lg hover:shadow-emerald-900/40 transition-all"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
          <span>WhatsApp Estimate</span>
        </button>

        <button
          type="button"
          data-open-call
          class="inline-flex items-center gap-2 px-5 py-3.5 rounded-full bg-white/10 hover:bg-white/20 text-white hover:text-amber-300 border border-white/20 hover:border-amber-400/50 font-semibold text-xs uppercase tracking-wider backdrop-blur-sm transition-all shadow-sm"
        >
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>Call Fabricator</span>
        </button>
      </div>

      <!-- Sleek Trust Row -->
      <div class="pt-8 mt-8 border-t border-white/10 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-zinc-400">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Surathkal &amp; Mangaluru Workshop</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          <span>15+ Years Direct Fabrication</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
          <span>IS Structural Safety Compliant</span>
        </div>
      </div>
    </div>
  </div>
</section>
