---
import type { MediaVideoSource } from '../data/media';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle: string;
  badge?: string;
  video: MediaVideoSource;
  breadcrumbs?: BreadcrumbItem[];
  serviceName?: string;
}

const {
  title,
  subtitle,
  badge = 'NEEDS GROUP SURATHKAL',
  video,
  breadcrumbs = [],
  serviceName,
} = Astro.props;
---

<section class="relative bg-gradient-to-b from-zinc-50 via-white to-zinc-50/50 border-b border-zinc-200 py-12 sm:py-16 lg:py-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: 100% Legible Text Content on Clean Solid Ground -->
      <div class="lg:col-span-7 space-y-5">
        <!-- Breadcrumb navigation -->
        {breadcrumbs.length > 0 && (
          <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-2 text-xs text-zinc-500 font-mono">
              <li>
                <a href="/" class="hover:text-amber-800 transition-colors">Home</a>
              </li>
              {breadcrumbs.map((crumb) => (
                <li class="flex items-center gap-2">
                  <span class="text-zinc-400">/</span>
                  {crumb.href ? (
                    <a href={crumb.href} class="hover:text-amber-800 transition-colors">
                      {crumb.label}
                    </a>
                  ) : (
                    <span class="text-amber-900 font-semibold" aria-current="page">
                      {crumb.label}
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}

        <!-- Banner Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-xs font-bold tracking-widest uppercase shadow-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-amber-600 animate-pulse"></span>
          {badge}
        </div>

        <!-- Main Heading (Crisp high-contrast dark typography) -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight font-heading leading-tight">
          {title}
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-zinc-600 max-w-2xl leading-relaxed">
          {subtitle}
        </p>

        <!-- Quick Action CTAs -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-open-whatsapp
            data-service={serviceName || title}
            class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-emerald-600 hover:bg-emerald-700 hover:scale-[1.02] active:scale-[0.98] text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
            <span>WhatsApp Estimate</span>
          </button>

          <button
            type="button"
            data-open-call
            class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white hover:bg-zinc-50 text-zinc-700 hover:text-amber-800 border border-zinc-200 hover:border-amber-300 font-semibold text-xs uppercase tracking-wider transition-colors shadow-sm"
          >
            <svg class="w-4 h-4 text-amber-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>Call Fabricator</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Framed Architectural Video Showcase Window (Zero Text Interference) -->
      <div class="lg:col-span-5">
        <div
          class="relative w-full aspect-[16/10] sm:aspect-[16/9] rounded-2xl overflow-hidden border border-zinc-200/90 shadow-[0_15px_35px_-5px_rgba(0,0,0,0.12)] bg-zinc-950 bg-cover bg-center group"
          style={`background-image: url('${video.poster}');`}
        >
          <video
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            poster={video.poster}
            aria-label={video.title || title}
          >
            <source src={video.mp4} type="video/mp4" />
          </video>

          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-transparent to-transparent pointer-events-none"></div>

          <!-- Live Telemetry Badge -->
          <div class="absolute bottom-3 left-3 flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-950/80 backdrop-blur-md border border-white/10 text-[10px] text-white font-mono shadow-sm pointer-events-none">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="font-medium tracking-wider uppercase text-zinc-200">LIVE MOTION • 1080P SPEC</span>
          </div>

          <!-- Video Lightbox / Expand Button -->
          <button
            type="button"
            data-lightbox-trigger
            data-type="video"
            data-video-mp4={video.mp4}
            data-video-webm={video.webm || ''}
            data-title={video.title || title}
            data-description={subtitle}
            class="absolute top-3 right-3 p-2 rounded-xl bg-zinc-950/70 hover:bg-zinc-950/90 text-white/90 hover:text-white border border-white/15 backdrop-blur-md transition-all shadow-md focus:outline-none"
            title="Expand Fullscreen Showcase"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
            </svg>
          </button>
        </div>
      </div>

    </div>
  </div>
</section>
