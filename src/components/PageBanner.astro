---
import VideoBanner from './VideoBanner.astro';
import type { MediaVideoSource } from '../data/media';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle: string;
  badge?: string;
  video: MediaVideoSource;
  breadcrumbs?: BreadcrumbItem[];
  serviceName?: string;
}

const {
  title,
  subtitle,
  badge = 'NEEDS GROUP SURATHKAL',
  video,
  breadcrumbs = [],
  serviceName,
} = Astro.props;
---

<section class="relative">
  <VideoBanner video={video} isHero={false} minHeightClass="min-h-[380px] lg:min-h-[440px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      
      <!-- Breadcrumb navigation -->
      {breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-5">
          <ol class="flex flex-wrap items-center gap-2 text-xs text-slate-400">
            <li>
              <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
            </li>
            {breadcrumbs.map((crumb, idx) => (
              <li class="flex items-center gap-2">
                <span class="text-slate-600">/</span>
                {crumb.href ? (
                  <a href={crumb.href} class="hover:text-amber-400 transition-colors">
                    {crumb.label}
                  </a>
                ) : (
                  <span class="text-amber-400/90 font-medium" aria-current="page">
                    {crumb.label}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}

      <!-- Banner Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-900/80 border border-amber-500/30 text-amber-400 text-xs font-semibold tracking-wider uppercase mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        {badge}
      </div>

      <!-- Main Heading -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-heading max-w-4xl leading-tight">
        {title}
      </h1>

      <!-- Subtitle -->
      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
        {subtitle}
      </p>

      <!-- Quick Action CTAs -->
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <button
          type="button"
          data-open-whatsapp
          data-service={serviceName || title}
          class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-sm shadow-lg hover:shadow-glow transition-all"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
          <span>Get Free Estimate on WhatsApp</span>
        </button>

        <button
          type="button"
          data-open-call
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 border border-slate-700 font-medium text-sm transition-colors"
        >
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>Call Fabricator</span>
        </button>
      </div>

    </div>
  </VideoBanner>
</section>
