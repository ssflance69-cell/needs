---
import { siteConfig } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  {
    label: 'Services',
    href: '/services/',
    hasSubmenu: true,
    sublinks: [
      { label: 'All Services Overview', href: '/services/' },
      { label: 'Steel & Glass Railings', href: '/services/railings/' },
      { label: 'Architectural Windows', href: '/services/windows/' },
      { label: 'Glass Canopies', href: '/services/glass-canopy/' },
      { label: 'Interior Work & Dividers', href: '/services/interior-work/' },
      { label: 'Turnkey Construction', href: '/services/construction/' },
    ],
  },
  { label: 'Projects', href: '/projects/' },
  { label: 'Contact', href: '/contact/' },
];

const isLinkActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header id="main-header" class="sticky top-3 sm:top-5 z-40 w-full px-3 sm:px-6 lg:px-8 transition-all duration-300">
  <div class="max-w-7xl mx-auto rounded-full bg-white/95 backdrop-blur-2xl border border-zinc-200/90 shadow-[0_10px_35px_-5px_rgba(24,24,27,0.06)] px-4 sm:px-6 py-2.5 sm:py-3 transition-all duration-300">
    <div class="flex items-center justify-between">
      
      <!-- Brand Logo Anchor -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none rounded-lg p-1 transition-transform duration-150 active:scale-[0.98]">
        <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 flex items-center justify-center shadow-sm group-hover:border-amber-400 group-hover:shadow-[0_0_15px_rgba(180,83,9,0.25)] transition-all duration-300">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-bold tracking-tight text-zinc-900 font-heading group-hover:text-amber-800 transition-colors leading-tight">
            {siteConfig.name}
          </span>
          <span class="text-[9px] sm:text-[10px] font-bold tracking-widest uppercase text-amber-800 font-mono mt-0.5">
            Architectural Metal &amp; Glazing
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
        {navLinks.map((item) => (
          item.hasSubmenu ? (
            <div class="relative group">
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider rounded-full transition-all duration-200',
                  isLinkActive(item.href)
                    ? 'text-amber-900 bg-amber-50 border border-amber-200 shadow-sm'
                    : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100/70',
                ]}
              >
                <span>{item.label}</span>
                <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-amber-800 transition-transform group-hover:rotate-180 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              <!-- Dropdown Menu -->
              <div class="absolute left-0 top-full pt-2 w-64 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
                <div class="p-2 rounded-2xl bg-white/95 border border-zinc-200 shadow-xl backdrop-blur-xl space-y-1">
                  {item.sublinks?.map((sub) => (
                    <a
                      href={sub.href}
                      class:list={[
                        'block px-3 py-2 text-xs font-medium rounded-xl transition-all duration-150',
                        currentPath === sub.href
                          ? 'text-amber-900 bg-amber-50 font-semibold border border-amber-200/60'
                          : 'text-zinc-700 hover:text-amber-800 hover:bg-amber-50/50',
                      ]}
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider rounded-full transition-all duration-200',
                isLinkActive(item.href)
                  ? 'text-amber-900 bg-amber-50 border border-amber-200 shadow-sm'
                  : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100/70',
              ]}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <!-- Desktop Contact Actions -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        <!-- Direct Phone Icon Button -->
        <button
          type="button"
          data-open-call
          class="hidden sm:inline-flex items-center justify-center w-9 h-9 rounded-full bg-zinc-50 border border-zinc-200 text-zinc-700 hover:text-amber-800 hover:border-amber-300 transition-all duration-300 shadow-sm"
          title="Direct Engineering Desk"
          aria-label="Call Needs Group"
        >
          <svg class="w-4 h-4 text-amber-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </button>

        <!-- WhatsApp Quick Chat Button -->
        <button
          type="button"
          data-open-whatsapp
          class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 hover:bg-emerald-100 hover:border-emerald-300 transition-all duration-300 shadow-sm"
          aria-label="WhatsApp Needs Group"
        >
          <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
          <span>WhatsApp</span>
        </button>

        <!-- Primary Quote CTA Button -->
        <a
          href="/contact/"
          class="inline-flex items-center gap-1.5 px-4 sm:px-5 py-2 text-xs font-bold uppercase tracking-wider rounded-full bg-gradient-to-r from-amber-700 via-amber-600 to-amber-800 text-white shadow-[0_4px_16px_rgba(180,83,9,0.3)] hover:shadow-[0_6px_22px_rgba(180,83,9,0.45)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300"
        >
          <span>Get Quote</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Mobile Hamburger Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden p-2 rounded-full bg-zinc-50 border border-zinc-200 text-zinc-700 hover:bg-zinc-100 transition-colors focus:outline-none"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
          aria-label="Toggle Navigation Menu"
        >
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Slide-out Menu Drawer -->
  <div
    id="mobile-menu-drawer"
    class="fixed inset-x-4 top-20 rounded-3xl bg-white/98 backdrop-blur-2xl border border-zinc-200 p-6 shadow-2xl hidden flex-col justify-between transition-all duration-300 max-h-[80vh] overflow-y-auto"
  >
    <div class="space-y-4">
      <div class="text-[10px] font-bold tracking-widest uppercase text-amber-800 font-mono">Navigation Protocol</div>
      <div class="space-y-1">
        <a
          href="/"
          class:list={[
            'block px-4 py-2.5 rounded-xl text-sm font-medium transition-colors',
            currentPath === '/' ? 'bg-amber-50 text-amber-900 border border-amber-200 font-bold' : 'text-zinc-700 hover:bg-zinc-100',
          ]}
        >
          Home
        </a>
        <a
          href="/about/"
          class:list={[
            'block px-4 py-2.5 rounded-xl text-sm font-medium transition-colors',
            currentPath === '/about/' ? 'bg-amber-50 text-amber-900 border border-amber-200 font-bold' : 'text-zinc-700 hover:bg-zinc-100',
          ]}
        >
          About Us (15 Years Heritage)
        </a>
        <div class="pt-2 pb-1">
          <div class="px-4 text-[10px] font-bold tracking-widest uppercase text-amber-800 font-mono">Fabrication Services</div>
          <div class="mt-1 pl-2 space-y-1 border-l border-zinc-200 ml-4">
            <a href="/services/" class="block px-3 py-1.5 text-xs text-zinc-600 hover:text-amber-800">All Services Overview</a>
            <a href="/services/railings/" class="block px-3 py-1.5 text-xs text-zinc-600 hover:text-amber-800">Steel, GI &amp; Glass Railings</a>
            <a href="/services/windows/" class="block px-3 py-1.5 text-xs text-zinc-600 hover:text-amber-800">Architectural Windows</a>
            <a href="/services/glass-canopy/" class="block px-3 py-1.5 text-xs text-zinc-600 hover:text-amber-800">Glass Canopies</a>
            <a href="/services/interior-work/" class="block px-3 py-1.5 text-xs text-zinc-600 hover:text-amber-800">Interior Work &amp; Dividers</a>
            <a href="/services/construction/" class="block px-3 py-1.5 text-xs text-zinc-600 hover:text-amber-800">Turnkey Construction</a>
          </div>
        </div>
        <a
          href="/projects/"
          class:list={[
            'block px-4 py-2.5 rounded-xl text-sm font-medium transition-colors',
            currentPath === '/projects/' ? 'bg-amber-50 text-amber-900 border border-amber-200 font-bold' : 'text-zinc-700 hover:bg-zinc-100',
          ]}
        >
          Projects Gallery &amp; Videos
        </a>
        <a
          href="/contact/"
          class:list={[
            'block px-4 py-2.5 rounded-xl text-sm font-medium transition-colors',
            currentPath === '/contact/' ? 'bg-amber-50 text-amber-900 border border-amber-200 font-bold' : 'text-zinc-700 hover:bg-zinc-100',
          ]}
        >
          Contact &amp; Location (Surathkal)
        </a>
      </div>
    </div>

    <!-- Mobile Drawer Footer Actions -->
    <div class="pt-5 mt-5 border-t border-zinc-200 space-y-2.5">
      <button
        type="button"
        data-open-whatsapp
        class="w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 font-semibold text-xs shadow-sm"
      >
        <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
        </svg>
        <span>Chat on WhatsApp</span>
      </button>

      <button
        type="button"
        data-open-call
        class="w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-zinc-50 border border-zinc-200 text-zinc-800 font-semibold text-xs"
      >
        <svg class="w-4 h-4 text-amber-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>Call Direct Engineering Line</span>
      </button>
      
      <div class="text-center text-[11px] text-zinc-400 font-mono pt-1">
        Surathkal, Mangaluru • Needs Group
      </div>
    </div>
  </div>
</header>

<script>
  (function initHeader() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    const hamIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    let isOpen = false;

    function setMenuState(open: boolean) {
      isOpen = open;
      toggle?.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        drawer?.classList.remove('hidden');
        drawer?.classList.add('flex');
        hamIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      } else {
        drawer?.classList.add('hidden');
        drawer?.classList.remove('flex');
        hamIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    }

    toggle?.addEventListener('click', () => {
      setMenuState(!isOpen);
    });

    drawer?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        setMenuState(false);
      });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        setMenuState(false);
      }
    });
  })();
</script>