---
import { siteConfig } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  {
    label: 'Services',
    href: '/services/',
    hasSubmenu: true,
    sublinks: [
      { label: 'All Services Overview', href: '/services/' },
      { label: 'Steel & Glass Railings', href: '/services/railings/' },
      { label: 'Architectural Windows', href: '/services/windows/' },
      { label: 'Glass Canopies', href: '/services/glass-canopy/' },
      { label: 'Interior Fitouts', href: '/services/interior-work/' },
      { label: 'Turnkey Construction', href: '/services/construction/' },
    ],
  },
  { label: 'Projects', href: '/projects/' },
  { label: 'Contact', href: '/contact/' },
];

const isLinkActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header
  id="main-header"
  class="sticky top-0 z-40 w-full transition-all duration-300 bg-slate-950/85 backdrop-blur-md border-b border-slate-800/80"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3.5 group focus:outline-none focus:ring-2 focus:ring-amber-400 rounded-lg p-1">
        <div class="w-11 h-11 rounded-xl bg-slate-900 border border-amber-500/30 flex items-center justify-center text-amber-400 shadow-md group-hover:border-amber-400 group-hover:shadow-glow transition-all duration-300">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-bold tracking-tight text-white font-heading group-hover:text-amber-400 transition-colors">
            {siteConfig.name}
          </span>
          <span class="text-[11px] font-medium tracking-wider uppercase text-amber-400/90">
            {siteConfig.tagline}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
        {navLinks.map((item) => (
          item.hasSubmenu ? (
            <div class="relative group">
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center gap-1.5 px-3.5 py-2 text-sm font-medium rounded-lg transition-colors',
                  isLinkActive(item.href)
                    ? 'text-amber-400 bg-slate-800/60 border border-slate-700/60'
                    : 'text-slate-300 hover:text-white hover:bg-slate-800/40',
                ]}
              >
                <span>{item.label}</span>
                <svg class="w-4 h-4 text-slate-400 group-hover:text-white transition-transform group-hover:rotate-180 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              <!-- Dropdown Menu -->
              <div class="absolute left-0 top-full pt-2 w-64 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
                <div class="p-2 rounded-xl bg-slate-900 border border-slate-800 shadow-2xl space-y-1">
                  {item.sublinks?.map((sub) => (
                    <a
                      href={sub.href}
                      class:list={[
                        'block px-3 py-2 text-xs font-medium rounded-lg transition-colors',
                        currentPath === sub.href
                          ? 'text-amber-400 bg-slate-800'
                          : 'text-slate-300 hover:text-white hover:bg-slate-800/60',
                      ]}
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'px-3.5 py-2 text-sm font-medium rounded-lg transition-colors',
                isLinkActive(item.href)
                  ? 'text-amber-400 bg-slate-800/60 border border-slate-700/60'
                  : 'text-slate-300 hover:text-white hover:bg-slate-800/40',
              ]}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <!-- Desktop Contact Actions -->
      <div class="hidden sm:flex items-center gap-3">
        <!-- Call Button -->
        <button
          type="button"
          data-open-call
          class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 hover:border-slate-600 transition-all focus:outline-none focus:ring-2 focus:ring-amber-400"
          aria-label="Call Needs Group"
        >
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>Call Us</span>
        </button>

        <!-- WhatsApp Button -->
        <button
          type="button"
          data-open-whatsapp
          class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white shadow-md hover:shadow-glow transition-all focus:outline-none focus:ring-2 focus:ring-emerald-400"
          aria-label="WhatsApp Needs Group"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
          <span>WhatsApp</span>
        </button>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden items-center gap-2">
        <button
          type="button"
          data-open-whatsapp
          class="p-2 rounded-lg bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 sm:hidden"
          aria-label="WhatsApp quick chat"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
        </button>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-amber-400"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
          aria-label="Toggle Navigation Menu"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Slide-out Menu Drawer -->
  <div
    id="mobile-menu-drawer"
    class="fixed inset-x-0 top-20 bottom-0 bg-slate-950/95 backdrop-blur-xl border-t border-slate-800 p-6 overflow-y-auto hidden flex-col justify-between transition-all duration-300"
  >
    <div class="space-y-4">
      <div class="text-xs font-semibold tracking-wider uppercase text-slate-400">Navigation</div>
      <div class="space-y-1.5">
        <a
          href="/"
          class:list={[
            'block px-4 py-3 rounded-xl text-base font-medium transition-colors',
            currentPath === '/' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/30' : 'text-slate-200 hover:bg-slate-900',
          ]}
        >
          Home
        </a>
        <a
          href="/about/"
          class:list={[
            'block px-4 py-3 rounded-xl text-base font-medium transition-colors',
            currentPath === '/about/' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/30' : 'text-slate-200 hover:bg-slate-900',
          ]}
        >
          About Us (15 Years Heritage)
        </a>
        <div class="pt-2 pb-1">
          <div class="px-4 text-xs font-semibold tracking-wider uppercase text-amber-400">Services</div>
          <div class="mt-2 pl-2 space-y-1 border-l-2 border-slate-800 ml-4">
            <a href="/services/" class="block px-3 py-2 text-sm text-slate-300 hover:text-white">All Services Overview</a>
            <a href="/services/railings/" class="block px-3 py-2 text-sm text-slate-300 hover:text-white">Steel, GI & Glass Railings</a>
            <a href="/services/windows/" class="block px-3 py-2 text-sm text-slate-300 hover:text-white">Architectural Windows</a>
            <a href="/services/glass-canopy/" class="block px-3 py-2 text-sm text-slate-300 hover:text-white">Glass Canopies</a>
            <a href="/services/interior-work/" class="block px-3 py-2 text-sm text-slate-300 hover:text-white">Interior Work & Dividers</a>
            <a href="/services/construction/" class="block px-3 py-2 text-sm text-slate-300 hover:text-white">Turnkey Construction</a>
          </div>
        </div>
        <a
          href="/projects/"
          class:list={[
            'block px-4 py-3 rounded-xl text-base font-medium transition-colors',
            currentPath === '/projects/' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/30' : 'text-slate-200 hover:bg-slate-900',
          ]}
        >
          Projects Gallery & Videos
        </a>
        <a
          href="/contact/"
          class:list={[
            'block px-4 py-3 rounded-xl text-base font-medium transition-colors',
            currentPath === '/contact/' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/30' : 'text-slate-200 hover:bg-slate-900',
          ]}
        >
          Contact & Location (Surathkal)
        </a>
      </div>
    </div>

    <!-- Mobile Drawer Footer Actions -->
    <div class="pt-6 mt-6 border-t border-slate-800 space-y-3">
      <button
        type="button"
        data-open-whatsapp
        class="w-full flex items-center justify-center gap-2.5 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-sm shadow-md"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
        </svg>
        <span>Chat on WhatsApp</span>
      </button>

      <button
        type="button"
        data-open-call
        class="w-full flex items-center justify-center gap-2.5 py-3 rounded-xl bg-slate-900 border border-slate-700 hover:bg-slate-800 text-slate-200 font-medium text-sm"
      >
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>Call Direct Line</span>
      </button>
      
      <div class="text-center text-xs text-slate-500 pt-1">
        Surathkal, Mangaluru • Needs Group
      </div>
    </div>
  </div>
</header>

<script>
  (function initHeader() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    const hamIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    let isOpen = false;

    function setMenuState(open: boolean) {
      isOpen = open;
      toggle?.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        drawer?.classList.remove('hidden');
        drawer?.classList.add('flex');
        hamIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } else {
        drawer?.classList.add('hidden');
        drawer?.classList.remove('flex');
        hamIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    toggle?.addEventListener('click', () => {
      setMenuState(!isOpen);
    });

    // Close when clicking internal links
    drawer?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        setMenuState(false);
      });
    });

    // Close on escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        setMenuState(false);
      }
    });
  })();
</script>
