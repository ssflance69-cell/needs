---
import { siteConfig } from '../data/site';

interface Props {
  defaultService?: string;
}

const { defaultService = 'fabrication & construction services' } = Astro.props;
const numbers = siteConfig.whatsappNumbers;
---

<!-- Reusable WhatsApp & Call Contact Modal -->
<div
  id="contact-picker-modal"
  class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center p-0 sm:p-4 bg-zinc-900/60 backdrop-blur-md transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="contact-modal-title"
  tabindex="-1"
>
  <div
    class="w-full sm:max-w-md bg-white border border-zinc-200 sm:rounded-2xl rounded-t-2xl p-6 shadow-2xl transform transition-transform duration-300 translate-y-full sm:translate-y-0 text-zinc-800"
    id="contact-picker-card"
  >
    <!-- Modal Header -->
    <div class="flex items-center justify-between pb-4 border-b border-zinc-100">
      <div class="flex items-center gap-3">
        <div id="modal-icon-wa" class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600 shadow-sm">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
        </div>
        <div id="modal-icon-call" class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 hidden items-center justify-center text-amber-800 shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </div>
        <div>
          <h3 id="contact-modal-title" class="text-lg font-semibold text-zinc-900 font-heading">Connect with Needs Group</h3>
          <p id="contact-modal-subtitle" class="text-xs text-zinc-500">Select a direct channel for fast assistance</p>
        </div>
      </div>
      <button
        id="contact-picker-close"
        type="button"
        class="text-zinc-400 hover:text-zinc-700 p-2 rounded-lg hover:bg-zinc-100 transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500"
        aria-label="Close dialog"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Active Inquiry Message Preview -->
    <div id="wa-prefill-preview" class="mt-4 p-3 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-zinc-700">
      <span class="text-amber-800 font-semibold font-mono">Inquiry Topic:</span>
      <p id="wa-message-text" class="mt-1 text-zinc-600 italic">"Hi Needs Group, I'm interested in {defaultService}. Please share details."</p>
    </div>

    <!-- Number Choices Options -->
    <div class="mt-5 space-y-3" id="contact-options-container">
      {numbers.map((item, index) => (
        <a
          href="#"
          data-wa-number={item.waNumber}
          data-tel-number={item.telNumber}
          class="contact-option-btn group flex items-center justify-between p-3.5 rounded-xl bg-zinc-50 hover:bg-amber-50/60 border border-zinc-200 hover:border-amber-300 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-amber-500"
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-white border border-zinc-200 shadow-sm flex items-center justify-center text-xs font-bold text-amber-800 group-hover:border-amber-400">
              {index + 1}
            </div>
            <div>
              <div class="text-sm font-semibold text-zinc-900 group-hover:text-amber-800 transition-colors">
                {item.label}
              </div>
              <div class="text-xs text-zinc-500 font-mono">{item.displayNumber}</div>
              {item.description && (
                <div class="text-[11px] text-zinc-400 mt-0.5">{item.description}</div>
              )}
            </div>
          </div>
          <div class="text-zinc-400 group-hover:text-amber-800 transition-transform group-hover:translate-x-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-4 pt-3 border-t border-zinc-100 flex items-center justify-between text-[11px] text-zinc-500 font-mono">
      <span>Surathkal, Mangaluru</span>
      <span class="text-emerald-700 font-medium flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
        Fast response
      </span>
    </div>
  </div>
</div>

<script>
  // Contact Picker Controller
  (function initContactPicker() {
    const modal = document.getElementById('contact-picker-modal');
    const card = document.getElementById('contact-picker-card');
    const closeBtn = document.getElementById('contact-picker-close');
    const titleEl = document.getElementById('contact-modal-title');
    const subTitleEl = document.getElementById('contact-modal-subtitle');
    const waIcon = document.getElementById('modal-icon-wa');
    const callIcon = document.getElementById('modal-icon-call');
    const prefillPreview = document.getElementById('wa-prefill-preview');
    const messageText = document.getElementById('wa-message-text');
    const optionBtns = document.querySelectorAll('.contact-option-btn');

    let currentMode: 'whatsapp' | 'call' = 'whatsapp';
    let currentService = 'fabrication & construction services';
    let previousActiveElement: HTMLElement | null = null;

    function buildWhatsAppUrl(number: string, service: string) {
      const text = `Hi Needs Group, I would like to get a quote/consultation regarding ${service}. Please assist me.`;
      return `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
    }

    function openModal(mode: 'whatsapp' | 'call', service?: string) {
      previousActiveElement = document.activeElement as HTMLElement;
      currentMode = mode;
      if (service) currentService = service;

      if (mode === 'whatsapp') {
        if (titleEl) titleEl.textContent = 'Chat on WhatsApp';
        if (subTitleEl) subTitleEl.textContent = 'Connect directly with our engineering team';
        waIcon?.classList.remove('hidden');
        callIcon?.classList.add('hidden');
        callIcon?.classList.remove('flex');
        prefillPreview?.classList.remove('hidden');
        if (messageText) {
          messageText.textContent = `"Hi Needs Group, I would like to get a quote/consultation regarding ${currentService}. Please assist me."`;
        }

        optionBtns.forEach((btn) => {
          const waNum = btn.getAttribute('data-wa-number') || '';
          btn.setAttribute('href', buildWhatsAppUrl(waNum, currentService));
          btn.setAttribute('target', '_blank');
          btn.setAttribute('rel', 'noopener noreferrer');
        });
      } else {
        if (titleEl) titleEl.textContent = 'Call Engineering Desk';
        if (subTitleEl) subTitleEl.textContent = 'Direct voice consultation for immediate requirements';
        waIcon?.classList.add('hidden');
        callIcon?.classList.remove('hidden');
        callIcon?.classList.add('flex');
        prefillPreview?.classList.add('hidden');

        optionBtns.forEach((btn) => {
          const telNum = btn.getAttribute('data-tel-number') || '';
          btn.setAttribute('href', `tel:${telNum}`);
          btn.removeAttribute('target');
          btn.removeAttribute('rel');
        });
      }

      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      // Slide up animation trigger
      requestAnimationFrame(() => {
        card?.classList.remove('translate-y-full');
      });
      closeBtn?.focus();
    }

    function closeModal() {
      card?.classList.add('translate-y-full');
      setTimeout(() => {
        modal?.classList.add('hidden');
        modal?.classList.remove('flex');
        if (previousActiveElement) {
          previousActiveElement.focus();
        }
      }, 200);
    }

    // Attach click listeners to all open triggers
    document.querySelectorAll('[data-open-whatsapp]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const service = trigger.getAttribute('data-service') || undefined;
        openModal('whatsapp', service);
      });
    });

    document.querySelectorAll('[data-open-call]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal('call');
      });
    });

    closeBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      }
    });
  })();
</script>