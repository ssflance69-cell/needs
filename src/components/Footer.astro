---
import { siteConfig } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 border-t border-slate-800 text-slate-300">
  <!-- Top Highlight Band -->
  <div class="border-b border-slate-900 bg-slate-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Headquarters</div>
            <div class="text-sm font-semibold text-white">Surathkal, Mangaluru, Karnataka</div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Proven Track Record</div>
            <div class="text-sm font-semibold text-white">15 Years • 900+ Railing Projects</div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Instant Consultation</div>
            <div class="text-sm font-semibold text-white">Dual WhatsApp Support Available</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Company Overview (Col 1 & 2) -->
      <div class="lg:col-span-2 space-y-5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-slate-900 border border-amber-500/40 flex items-center justify-center text-amber-400 font-bold">
            NG
          </div>
          <span class="text-xl font-bold text-white font-heading">{siteConfig.name}</span>
        </div>

        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          {siteConfig.longDescription}
        </p>

        <!-- Social Media Placeholders -->
        <div class="space-y-2">
          <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Follow Our Work</div>
          <div class="flex items-center gap-3 text-slate-400">
            <a href={siteConfig.socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:text-amber-400 hover:border-amber-400 transition-colors" aria-label="Instagram">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href={siteConfig.socialLinks.facebook} target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:text-amber-400 hover:border-amber-400 transition-colors" aria-label="Facebook">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href={siteConfig.socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:text-amber-400 hover:border-amber-400 transition-colors" aria-label="YouTube">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href={siteConfig.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:text-amber-400 hover:border-amber-400 transition-colors" aria-label="LinkedIn">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          </div>
          <p class="text-[11px] text-slate-500 italic">[Social profiles: Placeholders to connect official client handles]</p>
        </div>
      </div>

      <!-- Quick Links (Col 3) -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white font-heading">Explore</h4>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/" class="hover:text-amber-400 transition-colors">Home Page</a></li>
          <li><a href="/about/" class="hover:text-amber-400 transition-colors">About Needs Group</a></li>
          <li><a href="/services/" class="hover:text-amber-400 transition-colors">All Fabrication Services</a></li>
          <li><a href="/projects/" class="hover:text-amber-400 transition-colors">Projects & Video Portfolio</a></li>
          <li><a href="/contact/" class="hover:text-amber-400 transition-colors">Contact & Site Enquiries</a></li>
        </ul>
      </div>

      <!-- Services List (Col 4) -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white font-heading">Key Services</h4>
        <ul class="mt-4 space-y-2 text-xs">
          <li><a href="/services/railings/#glass-railing" class="hover:text-amber-400 transition-colors">Frameless Glass Railing</a></li>
          <li><a href="/services/railings/#steel-railing" class="hover:text-amber-400 transition-colors">SS 304/316 Steel Railing</a></li>
          <li><a href="/services/railings/#gi-railing" class="hover:text-amber-400 transition-colors">Galvanized GI Railing</a></li>
          <li><a href="/services/railings/#wood-railing" class="hover:text-amber-400 transition-colors">Wood & Glass Handrails</a></li>
          <li><a href="/services/railings/#aluminium-railing" class="hover:text-amber-400 transition-colors">Extruded Aluminium Railing</a></li>
          <li><a href="/services/windows/#aluminium-window" class="hover:text-amber-400 transition-colors">Acoustic Aluminium Windows</a></li>
          <li><a href="/services/windows/#steel-window" class="hover:text-amber-400 transition-colors">Steel Grills & Windows</a></li>
          <li><a href="/services/glass-canopy/" class="hover:text-amber-400 transition-colors">Laminated Glass Canopy</a></li>
          <li><a href="/services/interior-work/" class="hover:text-amber-400 transition-colors">Interior Metal Partitions</a></li>
          <li><a href="/services/construction/" class="hover:text-amber-400 transition-colors">Turnkey Civil & Structural</a></li>
        </ul>
      </div>

      <!-- Contact & Service Areas (Col 5) -->
      <div class="space-y-4">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white font-heading">Direct Contact</h4>
        
        <div class="space-y-2 text-xs text-slate-400">
          <div class="flex items-start gap-2">
            <span class="text-amber-400 font-bold">Location:</span>
            <span>{siteConfig.address.fullFormatted}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">Email:</span>
            <a href={`mailto:${siteConfig.email}`} class="text-slate-300 hover:text-white underline">{siteConfig.email}</a>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">WhatsApp:</span>
            <span>+91 93531 54607 / +91 84312 84752</span>
          </div>
        </div>

        <!-- Service Areas Pill List -->
        <div class="pt-2">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-2">Service Coverage (Coastal Karnataka):</div>
          <div class="flex flex-wrap gap-1.5">
            {siteConfig.serviceAreas.map((area) => (
              <span class="px-2 py-0.5 rounded text-[10px] bg-slate-900 border border-slate-800 text-slate-300">
                {area.name}
              </span>
            ))}
          </div>
          <p class="text-[10px] text-slate-500 mt-1 italic">[Areas marked confirm with client]</p>
        </div>
      </div>
    </div>

    <!-- Bottom Bar / Legal & GSTIN -->
    <div class="mt-12 pt-8 border-t border-slate-900 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-center sm:text-left">
        <div>
          &copy; {currentYear} {siteConfig.name}. All rights reserved.
        </div>
        <div class="text-slate-500 hidden sm:inline">•</div>
        <div class="text-slate-400">
          GSTIN: <span class="text-amber-400/90 font-mono">{siteConfig.gstin}</span>
        </div>
      </div>

      <div class="text-center md:text-right text-[11px] text-slate-400">
        Fabricated with precision in Surathkal, Mangaluru, Karnataka, India
      </div>
    </div>
  </div>
</footer>
