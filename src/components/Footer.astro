---
import { siteConfig } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-zinc-950 border-t border-zinc-900 text-zinc-400">
  <!-- Top Highlight Band -->
  <div class="border-b border-zinc-900 bg-zinc-900/50 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-amber-500 shrink-0 shadow-inner">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-widest text-zinc-400 font-mono font-bold">Fabrication Facility</div>
            <div class="text-sm font-semibold text-white">Surathkal, Mangaluru, Karnataka</div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-amber-500 shrink-0 shadow-inner">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-widest text-zinc-400 font-mono font-bold">Proven Track Record</div>
            <div class="text-sm font-semibold text-white">15 Years • 900+ Completed Installations</div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-emerald-400 shrink-0 shadow-inner">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-widest text-zinc-400 font-mono font-bold">Engineering Desk</div>
            <div class="text-sm font-semibold text-white">Dual WhatsApp &amp; Technical Support</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Company Overview (Col 1 & 2) -->
      <div class="lg:col-span-2 space-y-5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-amber-500 font-mono font-bold shadow-inner">
            NG
          </div>
          <span class="text-xl font-bold text-white font-heading">{siteConfig.name}</span>
        </div>

        <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed max-w-sm">
          {siteConfig.longDescription}
        </p>

        <!-- Material Certifications -->
        <div class="pt-2">
          <div class="text-[10px] font-bold uppercase tracking-widest text-amber-400 font-mono mb-2">Technical Certifications</div>
          <div class="flex flex-wrap gap-2 text-[10px] font-mono text-zinc-300">
            <span class="px-2.5 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-amber-200">AIS Certified Glazing</span>
            <span class="px-2.5 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-amber-200">Saint-Gobain Partner</span>
            <span class="px-2.5 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-amber-200">SS 316 Marine Grade</span>
          </div>
        </div>
      </div>

      <!-- Quick Links (Col 3) -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-white font-heading">Explore</h4>
        <ul class="mt-4 space-y-2.5 text-xs sm:text-sm">
          <li><a href="/" class="hover:text-amber-400 transition-colors">Home Page</a></li>
          <li><a href="/about/" class="hover:text-amber-400 transition-colors">About Needs Group</a></li>
          <li><a href="/services/" class="hover:text-amber-400 transition-colors">All Fabrication Services</a></li>
          <li><a href="/projects/" class="hover:text-amber-400 transition-colors">Projects &amp; Video Portfolio</a></li>
          <li><a href="/contact/" class="hover:text-amber-400 transition-colors">Contact &amp; Site Enquiries</a></li>
        </ul>
      </div>

      <!-- Services List (Col 4) -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-white font-heading">Key Services</h4>
        <ul class="mt-4 space-y-2 text-xs">
          <li><a href="/services/railings/#glass-railing" class="hover:text-amber-400 transition-colors">Frameless Glass Railing</a></li>
          <li><a href="/services/railings/#steel-railing" class="hover:text-amber-400 transition-colors">SS 304/316 Steel Railing</a></li>
          <li><a href="/services/railings/#gi-railing" class="hover:text-amber-400 transition-colors">Galvanized GI Railing</a></li>
          <li><a href="/services/railings/#wood-railing" class="hover:text-amber-400 transition-colors">Wood &amp; Glass Handrails</a></li>
          <li><a href="/services/railings/#aluminium-railing" class="hover:text-amber-400 transition-colors">Extruded Aluminium Railing</a></li>
          <li><a href="/services/windows/#steel-window" class="hover:text-amber-400 transition-colors">Steel Windows &amp; Grills</a></li>
          <li><a href="/services/windows/#gi-window" class="hover:text-amber-400 transition-colors">Galvanized GI Windows</a></li>
          <li><a href="/services/windows/#aluminium-window" class="hover:text-amber-400 transition-colors">Aluminium Sliding Windows</a></li>
          <li><a href="/services/glass-canopy/" class="hover:text-amber-400 transition-colors">Laminated Glass Canopy</a></li>
          <li><a href="/services/interior-work/" class="hover:text-amber-400 transition-colors">Interior Metal Partitions</a></li>
          <li><a href="/services/construction/" class="hover:text-amber-400 transition-colors">Turnkey Civil &amp; Structural</a></li>
        </ul>
      </div>

      <!-- Contact & Service Areas (Col 5) -->
      <div class="space-y-4">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white font-heading">Direct Contact</h4>
        
        <div class="space-y-2 text-xs text-zinc-400">
          <div class="flex items-start gap-2">
            <span class="text-amber-400 font-bold font-mono">Office:</span>
            <span class="text-zinc-300">{siteConfig.address.fullFormatted}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-bold font-mono">Email:</span>
            <a href={`mailto:${siteConfig.email}`} class="text-white hover:text-amber-400 underline">{siteConfig.email}</a>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-bold font-mono">WhatsApp:</span>
            <span class="text-zinc-300">+91 93531 54607 / +91 84312 84752</span>
          </div>
        </div>

        <!-- Service Areas Pill List -->
        <div class="pt-2">
          <div class="text-[10px] font-bold uppercase tracking-widest text-zinc-400 font-mono mb-2">Service Coverage (Coastal Karnataka):</div>
          <div class="flex flex-wrap gap-1.5">
            {siteConfig.serviceAreas.map((area) => (
              <span class="px-2.5 py-0.5 rounded-full text-[10px] bg-zinc-900 border border-zinc-800 text-zinc-300 font-mono">
                {area.name}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar / Legal & GSTIN -->
    <div class="mt-12 pt-8 border-t border-zinc-900 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-zinc-500">
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-center sm:text-left">
        <div>
          &copy; {currentYear} {siteConfig.name}. All rights reserved.
        </div>
        <div class="text-zinc-800 hidden sm:inline">•</div>
        <div>
          GSTIN: <span class="text-amber-400 font-mono">{siteConfig.gstin}</span>
        </div>
      </div>

      <div class="text-center md:text-right text-[11px] text-zinc-500 font-mono">
        Fabricated with precision in Surathkal, Mangaluru, Karnataka, India
      </div>
    </div>
  </div>
</footer>