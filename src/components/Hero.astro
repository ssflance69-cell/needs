---
import VideoBanner from './VideoBanner.astro';
import { mediaManifest } from '../data/media';
import { siteConfig } from '../data/site';

const heroVideo = mediaManifest.hero.video;
---

<section class="relative">
  <VideoBanner video={heroVideo} isHero={true} minHeightClass="min-h-[640px] sm:min-h-[720px] lg:min-h-[820px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl space-y-6">
        
        <!-- Regional Trust Pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-amber-500/40 backdrop-blur-md shadow-glow">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
          </span>
          <span class="text-xs font-semibold text-amber-300 tracking-wider uppercase">
            Surathkal • Mangaluru • Coastal Karnataka
          </span>
        </div>

        <!-- Main H1 Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight font-heading leading-[1.12]">
          Architectural Glass, <span class="text-gradient-amber">Steel & Aluminium</span> Railings in Mangaluru
        </h1>

        <!-- Subheadline / Value Proposition -->
        <p class="text-base sm:text-lg lg:text-xl text-slate-300 font-normal leading-relaxed">
          Master fabrication engineered for coastal weather resilience. From frameless toughened glass balustrades to heavy-duty windows, glass canopies, and turnkey construction across Mangalore & Surathkal.
        </p>

        <!-- Key Credibility Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-xs">
          <div class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>15 Years Experience</span>
          </div>
          <div class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>900+ Railing Projects</span>
          </div>
          <div class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>SS 304/316 Marine Grade</span>
          </div>
        </div>

        <!-- Three Primary CTAs (WhatsApp, Call, Get a Quote) -->
        <div class="pt-4 flex flex-wrap items-center gap-3.5">
          <!-- WhatsApp CTA -->
          <button
            type="button"
            data-open-whatsapp
            data-service="Architectural Railings & Windows Consultation"
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm shadow-xl hover:shadow-glow transition-all active:scale-95"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
            <span>Chat on WhatsApp</span>
          </button>

          <!-- Direct Call CTA -->
          <button
            type="button"
            data-open-call
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-100 border border-slate-700/80 hover:border-slate-600 font-semibold text-sm transition-all active:scale-95 shadow-md"
          >
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>Call Us Now</span>
          </button>

          <!-- Get a Quote (Links to Contact Form) -->
          <a
            href="/contact/#enquiry-form"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/40 font-semibold text-sm transition-all"
          >
            <span>Get a Quote</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </VideoBanner>
</section>
