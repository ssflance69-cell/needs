---
import VideoBanner from './VideoBanner.astro';
import { mediaManifest } from '../data/media';
import { siteConfig } from '../data/site';

const heroVideo = mediaManifest.hero.video;
---

<section class="relative bg-zinc-950">
  <VideoBanner
    video={heroVideo}
    isHero={true}
    minHeightClass="min-h-[740px] sm:min-h-[800px] lg:min-h-[880px]"
    overlayClass="bg-gradient-to-r from-zinc-950/92 via-zinc-950/75 to-zinc-950/45"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-28 relative z-10">
      <div class="max-w-4xl space-y-6 sm:space-y-8">
        
        <!-- Architectural Benchmark Tag -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/10 border border-amber-400/40 backdrop-blur-xl shadow-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
          </span>
          <span class="text-[10px] sm:text-xs font-bold text-amber-300 tracking-widest uppercase font-mono">
            Architectural Glazing &amp; Metal Benchmark • Coastal Karnataka
          </span>
        </div>

        <!-- Main Architectural H1 Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold text-white tracking-tight font-heading leading-[1.06]">
          Commanding Precision in <span class="text-gradient-bronze">Structural Glass &amp; Forged Steel</span>
        </h1>

        <!-- Subheadline / Value Proposition -->
        <p class="text-base sm:text-lg lg:text-xl text-zinc-300 font-normal leading-relaxed max-w-2xl">
          15+ Years Precision Craftsmanship &amp; 900+ Completed Installations across Mangaluru, Udupi &amp; Surathkal. Certified Structural Toughened Glazing &amp; Marine-Grade SS 316.
        </p>

        <!-- Primary Action CTAs -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <!-- Explore Projects Button -->
          <a
            href="/projects/"
            class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full bg-gradient-to-r from-amber-700 via-amber-600 to-amber-800 text-white font-bold text-sm tracking-wide shadow-[0_10px_25px_rgba(180,83,9,0.4)] hover:shadow-[0_15px_35px_rgba(180,83,9,0.55)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300"
          >
            <span>Explore Signature Projects</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- Instant WhatsApp Estimate -->
          <button
            type="button"
            data-open-whatsapp
            data-service="Architectural Glass & Steel Railings Consultation"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white hover:shadow-lg font-bold text-sm transition-all duration-300 active:scale-[0.98]"
          >
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
            <span>Instant WhatsApp Estimate</span>
          </button>

          <!-- Call Engineering Desk -->
          <button
            type="button"
            data-open-call
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-medium text-sm transition-all duration-300 shadow-sm backdrop-blur-md"
          >
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>Direct Call</span>
          </button>
        </div>

        <!-- High-Impact Live Trust Metrics Badges Grid -->
        <div
          id="hero-metrics-grid"
          class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 p-4 sm:p-5 rounded-2xl bg-zinc-950/85 backdrop-blur-2xl border border-white/10 shadow-[0_15px_40px_-10px_rgba(0,0,0,0.6)]"
        >
          <!-- Metric 1 -->
          <div
            class="hero-metric-card group/card relative p-2.5 sm:p-3 rounded-xl border border-transparent hover:border-amber-400/30 hover:bg-white/[0.04] transition-all duration-300 cursor-pointer sm:border-r sm:border-r-white/10 last:border-r-0"
            data-target="900"
            data-delay="150"
          >
            <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white flex items-baseline gap-1 font-heading tracking-tight">
              <span class="hero-metric-counter font-mono tabular-nums tracking-tighter" data-target="900">0</span>
              <span class="hero-metric-suffix text-amber-400 inline-block transition-transform duration-300 transform origin-bottom-left">+</span>
            </div>
            <p class="text-[10px] sm:text-xs font-bold text-amber-300 tracking-widest uppercase font-mono mt-0.5">
              Projects Delivered
            </p>
            <span class="text-[11px] text-zinc-400 font-mono block">
              Coastal Residential &amp; Comms
            </span>
          </div>

          <!-- Metric 2 -->
          <div
            class="hero-metric-card group/card relative p-2.5 sm:p-3 rounded-xl border border-transparent hover:border-amber-400/30 hover:bg-white/[0.04] transition-all duration-300 cursor-pointer sm:border-r sm:border-r-white/10 last:border-r-0"
            data-target="15"
            data-delay="300"
          >
            <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white flex items-baseline gap-1 font-heading tracking-tight">
              <span class="hero-metric-counter font-mono tabular-nums tracking-tighter" data-target="15">0</span>
              <span class="hero-metric-suffix text-amber-400 inline-block transition-transform duration-300 transform origin-bottom-left">+</span>
            </div>
            <p class="text-[10px] sm:text-xs font-bold text-amber-300 tracking-widest uppercase font-mono mt-0.5">
              Years Mastery
            </p>
            <span class="text-[11px] text-zinc-400 font-mono block">
              Surathkal &amp; Mangaluru
            </span>
          </div>

          <!-- Metric 3 -->
          <div
            class="hero-metric-card group/card relative p-2.5 sm:p-3 rounded-xl border border-transparent hover:border-amber-400/30 hover:bg-white/[0.04] transition-all duration-300 cursor-pointer sm:border-r sm:border-r-white/10 last:border-r-0"
            data-target="100"
            data-delay="450"
          >
            <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white flex items-baseline gap-1 font-heading tracking-tight">
              <span class="hero-metric-counter font-mono tabular-nums tracking-tighter" data-target="100">0</span>
              <span class="hero-metric-suffix text-amber-400 inline-block transition-transform duration-300 transform origin-bottom-left">%</span>
            </div>
            <p class="text-[10px] sm:text-xs font-bold text-amber-300 tracking-widest uppercase font-mono mt-0.5">
              AIS &amp; Saint-Gobain
            </p>
            <span class="text-[11px] text-zinc-400 font-mono block">
              Structural Certified Glass
            </span>
          </div>

          <!-- Metric 4 -->
          <div
            class="hero-metric-card group/card relative p-2.5 sm:p-3 rounded-xl border border-transparent hover:border-amber-400/30 hover:bg-white/[0.04] transition-all duration-300 cursor-pointer"
            data-target="10"
            data-delay="600"
          >
            <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white flex items-baseline gap-1 font-heading tracking-tight">
              <span class="hero-metric-counter font-mono tabular-nums tracking-tighter" data-target="10">0</span>
              <span class="hero-metric-suffix text-amber-400 inline-block transition-transform duration-300 transform origin-bottom-left">-Yr</span>
            </div>
            <p class="text-[10px] sm:text-xs font-bold text-amber-300 tracking-widest uppercase font-mono mt-0.5">
              Anti-Corrosion
            </p>
            <span class="text-[11px] text-zinc-400 font-mono block">
              SS 316 Marine Warranty
            </span>
          </div>
        </div>

      </div>
    </div>
  </VideoBanner>
</section>

<script>
  (function initHeroMetricsCounter() {
    const grid = document.getElementById('hero-metrics-grid');
    if (!grid) return;

    const cards = grid.querySelectorAll<HTMLElement>('.hero-metric-card');
    if (cards.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function easeOutExpo(x: number): number {
      return x === 1 ? 1 : 1 - Math.pow(2, -10 * x);
    }

    function animateSingleCounter(card: HTMLElement, isReplay = false) {
      const counterEl = card.querySelector<HTMLElement>('.hero-metric-counter');
      const suffixEl = card.querySelector<HTMLElement>('.hero-metric-suffix');
      if (!counterEl) return;

      const target = parseInt(card.getAttribute('data-target') || '0', 10);
      if (prefersReducedMotion || isNaN(target)) {
        counterEl.textContent = String(target);
        return;
      }

      const duration = isReplay ? 800 : 1700;
      let startTime: number | null = null;

      if (suffixEl) {
        suffixEl.classList.remove('scale-125', 'text-amber-300');
      }

      function step(now: number) {
        if (!startTime) startTime = now;
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = easeOutExpo(progress);
        const current = Math.floor(eased * target);

        counterEl.textContent = String(current);

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          counterEl.textContent = String(target);
          if (suffixEl) {
            suffixEl.classList.add('scale-125', 'text-amber-300');
            setTimeout(() => {
              suffixEl.classList.remove('scale-125', 'text-amber-300');
            }, 300);
          }
        }
      }

      requestAnimationFrame(step);
    }

    let hasRun = false;
    function triggerAll() {
      if (hasRun) return;
      hasRun = true;

      cards.forEach((card) => {
        const delay = parseInt(card.getAttribute('data-delay') || '0', 10);
        setTimeout(() => {
          animateSingleCounter(card, false);
        }, delay);
      });
    }

    // Interactive replay on hover/click
    cards.forEach((card) => {
      let cooldown = false;
      card.addEventListener('click', () => {
        if (cooldown) return;
        cooldown = true;
        animateSingleCounter(card, true);
        setTimeout(() => { cooldown = false; }, 1000);
      });

      card.addEventListener('mouseenter', () => {
        if (cooldown || !hasRun) return;
        cooldown = true;
        animateSingleCounter(card, true);
        setTimeout(() => { cooldown = false; }, 1200);
      });
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          triggerAll();
          observer.disconnect();
        }
      }, { threshold: 0.15 });
      observer.observe(grid);
    } else {
      triggerAll();
    }
  })();
</script>
