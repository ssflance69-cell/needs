---
import { siteConfig } from '../data/site';

const stats = siteConfig.stats;
---

<section class="relative py-12 bg-zinc-50/70 border-y border-zinc-200" id="stats-counter-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {stats.map((item, index) => (
        <div
          class="stat-card p-6 rounded-2xl bg-white border border-zinc-200 text-center space-y-1 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1 cursor-pointer group"
          data-target={item.value}
          data-delay={index * 150}
        >
          <div class="flex items-baseline justify-center">
            <span
              class="stat-counter text-4xl sm:text-5xl font-black text-zinc-900 font-heading font-mono tabular-nums tracking-tighter"
              data-target={item.value}
            >
              0
            </span>
            <span class="stat-suffix text-3xl sm:text-4xl font-extrabold text-amber-700 font-heading ml-1 transition-transform duration-300 inline-block origin-bottom-left">
              {item.suffix}
            </span>
          </div>
          <div class="text-sm font-semibold text-zinc-800">{item.label}</div>
          <div class="text-xs text-zinc-500 font-mono">{item.sublabel}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  (function initStatsCounter() {
    const section = document.getElementById('stats-counter-section');
    if (!section) return;

    const cards = section.querySelectorAll<HTMLElement>('.stat-card');
    if (cards.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function easeOutExpo(x: number): number {
      return x === 1 ? 1 : 1 - Math.pow(2, -10 * x);
    }

    function animateSingleCounter(card: HTMLElement, isReplay = false) {
      const counter = card.querySelector<HTMLElement>('.stat-counter');
      const suffix = card.querySelector<HTMLElement>('.stat-suffix');
      if (!counter) return;

      const target = parseInt(card.getAttribute('data-target') || '0', 10);
      if (prefersReducedMotion || isNaN(target)) {
        counter.textContent = String(target);
        return;
      }

      const duration = isReplay ? 800 : 1600;
      let startTime: number | null = null;

      if (suffix) {
        suffix.classList.remove('scale-125', 'text-amber-500');
      }

      function update(currentTime: number) {
        if (!startTime) startTime = currentTime;
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const easeProgress = easeOutExpo(progress);
        const currentVal = Math.floor(easeProgress * target);

        counter.textContent = String(currentVal);

        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          counter.textContent = String(target);
          if (suffix) {
            suffix.classList.add('scale-125', 'text-amber-500');
            setTimeout(() => {
              suffix.classList.remove('scale-125', 'text-amber-500');
            }, 300);
          }
        }
      }

      requestAnimationFrame(update);
    }

    let hasRun = false;
    function runAll() {
      if (hasRun) return;
      hasRun = true;

      cards.forEach((card) => {
        const delay = parseInt(card.getAttribute('data-delay') || '0', 10);
        setTimeout(() => {
          animateSingleCounter(card, false);
        }, delay);
      });
    }

    cards.forEach((card) => {
      let cooldown = false;
      card.addEventListener('click', () => {
        if (cooldown) return;
        cooldown = true;
        animateSingleCounter(card, true);
        setTimeout(() => { cooldown = false; }, 1000);
      });

      card.addEventListener('mouseenter', () => {
        if (cooldown || !hasRun) return;
        cooldown = true;
        animateSingleCounter(card, true);
        setTimeout(() => { cooldown = false; }, 1200);
      });
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            runAll();
            observer.disconnect();
          }
        },
        { threshold: 0.2 }
      );
      observer.observe(section);
    } else {
      runAll();
    }
  })();
</script>