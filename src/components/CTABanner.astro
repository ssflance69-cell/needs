---
interface Props {
  title?: string;
  subtitle?: string;
  serviceName?: string;
  badge?: string;
}

const {
  title = 'Ready to Elevate Your Architectural Space?',
  subtitle = 'Get laser-accurate site measurements, structural consultation, and a transparent quote in Indian Rupees (₹) anywhere across Surathkal, Mangaluru, and coastal Karnataka.',
  serviceName = 'General Fabrication & Railing Inquiry',
  badge = 'START YOUR PROJECT',
} = Astro.props;
---

<section class="relative py-16 sm:py-20 bg-slate-950 overflow-hidden">
  <!-- Glowing ambient orb -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="rounded-3xl bg-gradient-to-r from-slate-900 via-slate-900/95 to-slate-900 border border-slate-800 p-8 sm:p-12 lg:p-16 text-center space-y-6 shadow-2xl relative overflow-hidden">
      
      <!-- Top Accent Line -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 via-sky-400 to-amber-500"></div>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-950 border border-amber-500/30 text-amber-400 text-xs font-semibold tracking-wider uppercase">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        {badge}
      </div>

      <!-- Heading -->
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white font-heading max-w-3xl mx-auto leading-tight">
        {title}
      </h2>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        {subtitle}
      </p>

      <!-- Action Buttons -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <!-- WhatsApp Button -->
        <button
          type="button"
          data-open-whatsapp
          data-service={serviceName}
          class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm shadow-xl hover:shadow-glow transition-all active:scale-95"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
          <span>Chat on WhatsApp</span>
        </button>

        <!-- Call Button -->
        <button
          type="button"
          data-open-call
          class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-100 border border-slate-700 font-semibold text-sm transition-all active:scale-95"
        >
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>Call Fabricator Direct</span>
        </button>

        <!-- Quote Form Link -->
        <a
          href="/contact/#enquiry-form"
          class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-transparent hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-700 font-semibold text-sm transition-all"
        >
          <span>Online Inquiry Form</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="pt-2 text-xs text-slate-400">
        Workshop & Site Team Located in Surathkal, Mangaluru • Immediate Site Visits Across Coastal Karnataka
      </div>
    </div>
  </div>
</section>
