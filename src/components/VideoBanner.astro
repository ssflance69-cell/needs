---
import type { MediaVideoSource } from '../data/media';

interface Props {
  video: MediaVideoSource;
  isHero?: boolean;
  minHeightClass?: string;
  overlayClass?: string;
}

const {
  video,
  isHero = false,
  minHeightClass = 'min-h-[520px] lg:min-h-[620px]',
  overlayClass = isHero
    ? 'bg-gradient-to-r from-zinc-950/96 via-zinc-950/82 to-zinc-950/50'
    : 'bg-gradient-to-r from-white/95 via-white/80 sm:via-white/70 to-white/30 lg:to-transparent',
} = Astro.props;
---

<div
  class={`relative w-full overflow-hidden ${minHeightClass} flex items-center bg-zinc-950 bg-cover bg-center`}
  style={`background-image: url('${video.poster}');`}
  data-video-banner
>
  <!-- Background Video Element -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
    <video
      class="w-full h-full object-cover z-0"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster={video.poster}
      data-is-hero={isHero ? 'true' : 'false'}
      aria-hidden="true"
    >
      <source src={video.mp4} type="video/mp4" />
    </video>
  </div>

  <!-- Directional Architectural Scrim (Readable text on left, rich video on right) -->
  <div class={`absolute inset-0 z-10 ${overlayClass}`}></div>

  <!-- Bottom seamless blend (clean dark transition for hero, subtle blend for light sections) -->
  {isHero ? (
    <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-zinc-950 to-transparent z-10 pointer-events-none"></div>
  ) : (
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-white via-white/40 to-transparent z-10 pointer-events-none"></div>
  )}

  <!-- Soft Ambient Warm Bronze Spotlight -->
  <div class="absolute inset-0 z-10 bg-[radial-gradient(ellipse_at_75%_35%,rgba(180,83,9,0.18),transparent_65%)] pointer-events-none"></div>

  <!-- Live Cinematic Telemetry Badge (Bottom Right for Desktop) -->
  {isHero && (
    <div class="absolute bottom-10 right-6 z-20 hidden sm:flex items-center gap-3 px-3.5 py-1.5 rounded-full bg-zinc-950/80 backdrop-blur-md border border-white/10 shadow-lg font-mono text-[10px] text-zinc-300">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
      </span>
      <span class="font-semibold uppercase tracking-wider text-amber-300">Live Construction Motion</span>
      <span class="text-zinc-600">|</span>
      <span class="text-zinc-400">Structural Erection</span>
      <button
        type="button"
        data-video-toggle
        aria-label="Toggle background video playback"
        class="ml-1 p-1 rounded-full hover:bg-white/10 text-zinc-300 hover:text-amber-300 transition-colors pointer-events-auto"
        title="Toggle background video"
      >
        <svg class="w-3 h-3 pause-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M6 4h4v16H6zm8 0h4v16h-4z"/></svg>
        <svg class="w-3 h-3 play-icon hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      </button>
    </div>
  )}

  <!-- Content Slot -->
  <div class="relative z-20 w-full">
    <slot />
  </div>
</div>

<script>
  (function initVideoBanner() {
    const banners = document.querySelectorAll('[data-video-banner]');

    banners.forEach((banner) => {
      const video = banner.querySelector('video') as HTMLVideoElement | null;
      const toggleBtn = banner.querySelector('[data-video-toggle]') as HTMLButtonElement | null;
      const pauseIcon = banner.querySelector('.pause-icon');
      const playIcon = banner.querySelector('.play-icon');

      if (!video) return;

      // Ensure autoplay kicks off
      video.play().catch(() => {});

      // Toggle play/pause
      if (toggleBtn) {
        toggleBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (video.paused) {
            video.play();
            pauseIcon?.classList.remove('hidden');
            playIcon?.classList.add('hidden');
          } else {
            video.pause();
            pauseIcon?.classList.add('hidden');
            playIcon?.classList.remove('hidden');
          }
        });
      }
    });
  })();
</script>
