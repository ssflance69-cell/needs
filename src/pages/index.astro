---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsCounter from '../components/StatsCounter.astro';
import CTABanner from '../components/CTABanner.astro';
import { siteConfig } from '../data/site';
import { mediaManifest } from '../data/media';

// 6 Core Architectural Disciplines (Direct Switches to Dedicated Subpages)
const disciplines = [
  {
    title: 'Architectural Railings',
    tagline: 'Glass, Stainless Steel, GI, Aluminium & Wood Systems',
    description: 'Engineered with 12mm–17.52mm toughened safety glass and marine-grade SS 316 spigots or concealed aluminum bottom shoes.',
    href: '/services/railings/',
    image: '/images/services/glass-railing.webp',
    alt: 'Architectural Glass and Steel Railing Installation Mangaluru',
    badge: '5 Systems Available',
    specs: ['17.52mm Laminated Glass', 'SS 316 Marine Hardware', 'Zero Coastal Rust'],
  },
  {
    title: 'Entrance Gates',
    tagline: 'SS 304/316 & Heavy-Gauge Hot-Dip GI Compound Gates',
    description: 'Precision engineered for high security, coastal rust resistance, and automated sliding or swing operation for luxury villas.',
    href: '/services/gates/',
    image: '/images/services/gates.webp',
    alt: 'Custom Stainless Steel and Architectural Entrance Gate Mangaluru',
    badge: 'Custom Fabricated',
    specs: ['Motorized Automation', 'CNC Laser-Cut Louvers', 'Monsoon-Proof Finish'],
  },
  {
    title: 'Windows & Security Grills',
    tagline: 'Aluminium Sliding, Casement & Heavy-Duty Security Grills',
    description: 'Ultra-narrow sightline thermally broken frames with acoustic compression seals, paired with anti-corrosion GI/SS grills.',
    href: '/services/windows/',
    image: '/images/services/aluminium-window.webp',
    alt: 'Aluminium Sliding Windows and Security Grills Mangaluru',
    badge: 'Acoustic & Security',
    specs: ['Acoustic Double-Glazing', 'Anti-Corrosion GI & SS Grills', 'Multi-Point Locking'],
  },
  {
    title: 'Glass Canopies & Pergolas',
    tagline: 'Cantilevered Steel Framework & Spider-Glazed Shields',
    description: 'Heavy-duty structural steel frames paired with high-tensile spider fittings and laminated glass engineered for coastal monsoon gusts.',
    href: '/services/glass-canopy/',
    image: '/images/services/glass-canopy.webp',
    alt: 'Laminated Toughened Glass Canopy Mangaluru Villa',
    badge: 'Monsoon-Rated',
    specs: ['SentryGlas Lamination', 'Cast 316 Spider Fittings', 'Cyclonic Wind Tested'],
  },
  {
    title: 'Interior Partitions & Metalwork',
    tagline: 'Fluted Glass Screens, Brass PVD Frames & Custom Railings',
    description: 'Precision laser-profiled stainless steel frames in brushed titanium or brass finish, fitted with reeded or acoustic glass.',
    href: '/services/interior-work/',
    image: '/images/services/interior-work.webp',
    alt: 'Fluted Glass Metal Interior Partition Mangaluru',
    badge: 'Bespoke Interiors',
    specs: ['Fluted & Ribbed Glass', 'PVD Titanium Brass / Black', 'Acoustic Privacy'],
  },
  {
    title: 'Commercial Glazing & Façades',
    tagline: 'Curtain Walls, Point-Supported Spider Glazing & Structures',
    description: 'Point-supported glass curtain walls with heavy cast 316 stainless rotules and structural steel backup trusses.',
    href: '/services/construction/',
    image: '/images/services/construction.webp',
    alt: 'Commercial Structural Glazing and Metal Construction Mangaluru',
    badge: 'Structural Engineering',
    specs: ['Curtain Wall Glazing', 'Heavy Structural Steel', 'IS Safety Compliant'],
  },
];

// Curated 6 Signature Projects (2 per row on phone, 3 on desktop)
const curatedProjects = mediaManifest.projects.slice(0, 6);
---

<Layout
  title="Needs Group | Architectural Glass & Stainless Steel Fabrication Mangaluru"
  description="Premier specialist in architectural glass, steel & aluminium railings, custom entrance gates, windows, glass canopies, interior fabrication, and construction in Surathkal, Mangaluru, Karnataka."
  videoSchema={{
    name: mediaManifest.hero.video.title,
    description: mediaManifest.hero.video.description,
    thumbnailUrl: mediaManifest.hero.video.poster,
    uploadDate: mediaManifest.hero.video.uploadDate,
    contentUrl: mediaManifest.hero.video.mp4,
  }}
>
  <!-- 1. Hero with modern architectural styling & instant CTAs -->
  <Hero />

  <!-- 2. Core Architectural Disciplines (Compact 6-Card Category Grid) -->
  <section class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto" id="capabilities">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-12 gap-5">
      <div class="space-y-2.5 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-xs font-semibold tracking-wider uppercase shadow-xs">
          EXPLORE BY DISCIPLINE
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-900 tracking-tight font-heading">
          Precision Fabrication &amp; <span class="text-gradient-bronze">Glazing Disciplines</span>
        </h2>
        <p class="text-zinc-600 text-xs sm:text-sm leading-relaxed">
          Direct fabrication from our Surathkal workshop. Select any discipline below to view models, material specifications, and real site installations.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/services/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white border border-zinc-200 hover:border-amber-400 text-zinc-800 hover:text-amber-800 text-xs font-bold uppercase tracking-wider transition-all shadow-xs hover:shadow-sm"
        >
          <span>All Services Directory</span>
          <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Quick Pill Switches -->
    <div class="flex flex-wrap gap-2 mb-8">
      {disciplines.map((d) => (
        <a
          href={d.href}
          class="px-3.5 py-1.5 rounded-full bg-zinc-50 hover:bg-amber-50 border border-zinc-200 hover:border-amber-300 text-zinc-700 hover:text-amber-900 text-xs font-medium transition-all shadow-2xs hover:shadow-xs flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
          <span>{d.title}</span>
        </a>
      ))}
    </div>

    <!-- 6-Card Category Matrix (3 Cols on Desktop, 2 on Tablet, 1 on Mobile) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
      {disciplines.map((discipline) => (
        <div class="group rounded-3xl bg-white border border-zinc-200 hover:border-amber-400/80 transition-all duration-300 shadow-sm hover:shadow-xl overflow-hidden flex flex-col justify-between">
          <!-- Card Image Container -->
          <a href={discipline.href} class="block relative aspect-[16/10] overflow-hidden bg-zinc-100">
            <img
              src={discipline.image}
              alt={discipline.alt}
              width="600"
              height="375"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-transparent to-transparent"></div>

            <!-- Discipline Badge -->
            <div class="absolute top-3 left-3 px-3 py-1 rounded-full bg-white/95 backdrop-blur-md border border-zinc-200 text-[10px] font-bold tracking-widest uppercase text-amber-900 shadow-xs">
              {discipline.badge}
            </div>
          </a>

          <!-- Content Body -->
          <div class="p-5 sm:p-6 flex flex-col justify-between flex-1 space-y-4">
            <div class="space-y-2">
              <h3 class="text-lg sm:text-xl font-bold text-zinc-900 font-heading group-hover:text-amber-800 transition-colors">
                <a href={discipline.href} class="hover:underline decoration-amber-500/50">
                  {discipline.title}
                </a>
              </h3>
              <p class="text-xs text-amber-900 font-semibold line-clamp-1">
                {discipline.tagline}
              </p>
              <p class="text-xs text-zinc-500 line-clamp-2 leading-relaxed">
                {discipline.description}
              </p>
            </div>

            <!-- Key Spec Tags -->
            <div class="flex flex-wrap gap-1.5 pt-1">
              {discipline.specs.map((spec) => (
                <span class="px-2 py-0.5 rounded-md bg-zinc-50 border border-zinc-200 text-[10px] text-zinc-600 font-medium">
                  {spec}
                </span>
              ))}
            </div>

            <!-- Direct Switch Button -->
            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between">
              <a
                href={discipline.href}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-800 hover:text-amber-950 uppercase tracking-wider group-hover:translate-x-1 transition-transform"
              >
                <span>Explore {discipline.title.split(' ')[0]}</span>
                <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <span class="text-[11px] text-zinc-400">Direct Fabrication</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. Animated Trust & Delivery Metrics Band -->
  <StatsCounter />

  <!-- 4. Cinematic Metallurgy Ribbon: Surathkal Workshop Credentials -->
  <section class="relative py-16 sm:py-24 bg-zinc-950 text-white overflow-hidden my-4">
    <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none bg-cover bg-center" style="background-image: url('/images/about/about-poster.webp');">
      <video
        class="w-full h-full object-cover opacity-45 scale-105"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/images/about/about-poster.webp"
        aria-hidden="true"
      >
        <source src="/videos/services/about-workshop.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/95 to-zinc-950/60"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-zinc-950/80"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Content Column (7 cols) -->
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-white/10 border border-amber-400/30 text-amber-300 text-xs font-semibold tracking-wider uppercase backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span>SURATHKAL WORKSHOP • MASTER FABRICATION</span>
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight font-heading leading-tight">
            Where Raw Metallurgy Meets <span class="text-gradient-bronze">Monolithic Glazing</span>
          </h2>

          <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed max-w-xl">
            15 years of coastal testing has shaped our manufacturing standard. Every stainless steel post is argon-purged TIG welded, passivated against saline pit corrosion, and every glass reveal is laser-calibrated to ±0.5mm precision before leaving our Surathkal workshop.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href="/about/"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-gradient-to-r from-amber-700 via-amber-600 to-amber-800 text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg hover:scale-[1.01] transition-all"
            >
              <span>Explore Workshop Heritage</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>

            <button
              type="button"
              data-lightbox-trigger
              data-type="video"
              data-video-mp4="/videos/services/about-workshop.mp4"
              data-video-webm="/videos/services/about-workshop.webm"
              data-title="Needs Group Workshop & Engineering Heritage"
              data-description="Inside the 15-year master fabrication facility of Needs Group in Surathkal, Mangaluru."
              data-location="Surathkal, Mangaluru"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-xs uppercase tracking-wider backdrop-blur-md transition-all group"
            >
              <svg class="w-3.5 h-3.5 text-amber-400 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <span>Watch Workshop Tour</span>
            </button>
          </div>
        </div>

        <!-- Workshop Standards Column (5 cols) -->
        <div class="lg:col-span-5 grid grid-cols-2 gap-3.5">
          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xl space-y-1.5">
            <div class="font-heading text-xl sm:text-2xl font-extrabold text-amber-400">±0.5mm</div>
            <div class="text-[11px] font-bold text-white uppercase tracking-wider font-heading">Laser Calibration</div>
            <p class="text-[10px] text-zinc-400 leading-normal">Digital point-cloud surveying ensures tight plumb lines on site.</p>
          </div>

          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xl space-y-1.5">
            <div class="font-heading text-xl sm:text-2xl font-extrabold text-amber-400">SS 316</div>
            <div class="text-[11px] font-bold text-white uppercase tracking-wider font-heading">Marine-Grade Alloy</div>
            <p class="text-[10px] text-zinc-400 leading-normal">Certified chemical batch tests with zero pitting guarantee.</p>
          </div>

          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xl space-y-1.5">
            <div class="font-heading text-xl sm:text-2xl font-extrabold text-amber-400">200 km/h</div>
            <div class="text-[11px] font-bold text-white uppercase tracking-wider font-heading">Cyclonic Wind Rating</div>
            <p class="text-[10px] text-zinc-400 leading-normal">FEA structural stress tested to exceed IS 875 coastal wind standards.</p>
          </div>

          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xl space-y-1.5">
            <div class="font-heading text-xl sm:text-2xl font-extrabold text-amber-400">900+</div>
            <div class="text-[11px] font-bold text-white uppercase tracking-wider font-heading">Completed Works</div>
            <p class="text-[10px] text-zinc-400 leading-normal">Across Mangaluru, Udupi, Surathkal &amp; coastal Karnataka.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Curated Signature Installations (Clean 3-Card Snapshot) -->
  <section class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-zinc-200" id="projects">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-10 gap-5">
      <div class="space-y-2.5 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-xs font-semibold tracking-wider uppercase shadow-xs">
          RECENT INSTALLATIONS
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-900 tracking-tight font-heading">
          Real Works Across <span class="text-gradient-bronze">Coastal Karnataka</span>
        </h2>
        <p class="text-zinc-600 text-xs sm:text-sm leading-relaxed">
          A snapshot of verified site handovers. Filter through our full catalog of 900+ residential and commercial projects.
        </p>
      </div>

      <a
        href="/projects/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white border border-zinc-200 hover:border-amber-400 text-zinc-800 hover:text-amber-800 text-xs font-bold uppercase tracking-wider transition-all shrink-0 shadow-xs hover:shadow-sm"
      >
        <span>View All 900+ Projects</span>
        <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Curated Project Cards (2 per row on mobile, 3 on desktop) -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-6 sm:gap-7">
      {curatedProjects.map((item) => (
        <div
          class="group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-white border border-zinc-200 hover:border-amber-400/80 transition-all duration-300 shadow-xs sm:shadow-sm hover:shadow-xl cursor-pointer flex flex-col justify-between"
          data-lightbox-trigger
          data-type="image"
          data-image={item.image}
          data-title={item.title}
          data-description={item.description}
          data-location={item.location}
        >
          <div class="relative aspect-[4/3] sm:aspect-[16/10] w-full overflow-hidden bg-zinc-100">
            <img
              src={item.image}
              alt={item.alt}
              width="600"
              height="375"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-900/40 via-transparent to-transparent"></div>

            <div class="absolute top-2 left-2 sm:top-3 sm:left-3 px-2 sm:px-2.5 py-0.5 rounded-full bg-white/95 backdrop-blur-md border border-zinc-200 text-[8px] sm:text-[10px] font-bold tracking-wider sm:tracking-widest uppercase text-amber-900 shadow-xs">
              {item.category}
            </div>

            <div class="absolute bottom-2 left-2 sm:bottom-3 sm:left-3 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-md bg-white/90 backdrop-blur-sm text-[9px] sm:text-[11px] text-zinc-700 border border-zinc-200 flex items-center gap-1 sm:gap-1.5 shadow-xs">
              <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-amber-700 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="truncate max-w-[85px] sm:max-w-none">{item.location}</span>
            </div>
          </div>

          <div class="p-2.5 sm:p-5 space-y-1">
            <h3 class="text-xs sm:text-base font-bold text-zinc-900 group-hover:text-amber-800 transition-colors font-heading line-clamp-1">
              {item.title}
            </h3>
            <p class="text-[10px] sm:text-xs text-zinc-500 line-clamp-2 leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 6. Client Experiences -->
  <section class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-zinc-200">
    <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-xs font-semibold tracking-wider uppercase shadow-xs">
        CLIENT EXPERIENCES
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-900 tracking-tight font-heading">
        Trusted Across Coastal Karnataka
      </h2>
      <p class="text-zinc-600 text-xs sm:text-sm">
        Homeowners, builders, and architects who trusted Needs Group with their precision fabrication works.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {siteConfig.testimonials.map((t) => (
        <div class="rounded-3xl bg-white p-6 flex flex-col justify-between space-y-4 border border-zinc-200 shadow-xs hover:shadow-md hover:border-amber-400 transition-all">
          <div class="space-y-2.5">
            <div class="flex items-center gap-1 text-amber-500">
              {[...Array(t.rating)].map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-xs sm:text-sm text-zinc-600 italic leading-relaxed">
              "{t.review}"
            </p>
          </div>

          <div class="pt-3 border-t border-zinc-100">
            <div class="font-bold text-zinc-900 text-xs sm:text-sm font-heading">{t.name}</div>
            <div class="text-[11px] text-amber-800 font-semibold">{t.project}</div>
            <div class="text-[10px] text-zinc-400 mt-0.5">{t.location}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 7. High-Converting CTA Banner -->
  <CTABanner
    title="Start Your Architectural Fabrication Project Today"
    subtitle="Connect directly with our senior fabricators in Surathkal, Mangaluru for site measurement, design recommendations, and a transparent quote."
    serviceName="General Architectural Railing & Window Project"
  />
</Layout>
