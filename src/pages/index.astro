---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsCounter from '../components/StatsCounter.astro';
import VideoTile from '../components/VideoTile.astro';
import CTABanner from '../components/CTABanner.astro';
import { siteConfig } from '../data/site';
import { mediaManifest } from '../data/media';

const featuredVideos = mediaManifest.featuredVideos;
const recentProjects = mediaManifest.projects.slice(0, 6);
---

<Layout
  title="Needs Group | Architectural Glass & Stainless Steel Fabrication Mangaluru"
  description="Premier specialist in architectural glass, steel & aluminium railings, custom windows, glass canopies, interior fabrication, and construction in Surathkal, Mangaluru, Karnataka."
  videoSchema={{
    name: mediaManifest.hero.video.title,
    description: mediaManifest.hero.video.description,
    thumbnailUrl: mediaManifest.hero.video.poster,
    uploadDate: mediaManifest.hero.video.uploadDate,
    contentUrl: mediaManifest.hero.video.mp4,
  }}
>
  <!-- 1. Hero with modern architectural styling & live telemetry -->
  <Hero />

  <!-- 2. Core Architectural Capabilities (Dynamic Bento Grid) -->
  <section class="py-20 lg:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto" id="capabilities">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
      <div class="space-y-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-[11px] font-bold tracking-widest uppercase font-mono shadow-sm">
          CAPABILITIES &amp; ENGINEERING DISCIPLINES
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight font-heading">
          Engineered for Coastal Resilience &amp; <span class="text-gradient-bronze">Precision Architecture</span>
        </h2>
        <p class="text-zinc-600 text-sm sm:text-base leading-relaxed">
          Custom monolithic architectural glazing, marine-grade stainless hardware, and precision fabrication designed to endure saline coastal microclimates across Mangaluru, Udupi &amp; Surathkal.
        </p>
      </div>

      <a
        href="/services/"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-white border border-zinc-200 hover:border-amber-400 text-zinc-800 hover:text-amber-800 text-xs font-bold uppercase tracking-wider transition-all shrink-0 group shadow-sm hover:shadow-md"
      >
        <span>View All 11 Disciplines</span>
        <svg class="w-4 h-4 text-amber-700 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Bento Grid (Asymmetrical 12-Column Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <!-- Bento Card 1 (Span 8: Large Primary Feature) -->
      <div class="md:col-span-8 rounded-3xl bg-white border border-zinc-200 p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden group hover:border-amber-500/70 transition-all duration-300 shadow-sm hover:shadow-xl">
        <div class="absolute -right-20 -top-20 w-80 h-80 bg-amber-100/40 rounded-full blur-3xl pointer-events-none group-hover:bg-amber-200/40 transition-colors"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <span class="text-[10px] font-bold text-amber-900 uppercase tracking-widest px-3 py-1 rounded-full bg-amber-50 border border-amber-200 font-mono">
              DISCIPLINE 01
            </span>
            <span class="text-[11px] font-mono text-amber-700 tracking-wider font-semibold">
              TOLERANCE ±0.5mm
            </span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold text-zinc-900 font-heading mb-3 group-hover:text-amber-800 transition-colors">
            <a href="/services/railings/">Frameless &amp; Modular Glass Railings</a>
          </h3>
          <p class="text-sm text-zinc-600 max-w-xl mb-5 leading-relaxed">
            Engineered with 12mm to 17.52mm laminated toughened safety glass and marine-grade SS 316 spigots or concealed aluminum bottom-shoe channels. Complete with integrated low-voltage warm LED lighting and PVD titanium brass finishes.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 rounded-full bg-zinc-50 border border-zinc-200 text-xs font-mono text-zinc-700">17.52mm PVB Laminated</span>
            <span class="px-3 py-1 rounded-full bg-zinc-50 border border-zinc-200 text-xs font-mono text-zinc-700">SS 316 Marine Spigots</span>
            <span class="px-3 py-1 rounded-full bg-zinc-50 border border-zinc-200 text-xs font-mono text-zinc-700">Base Shoe Channel</span>
            <span class="px-3 py-1 rounded-full bg-zinc-50 border border-zinc-200 text-xs font-mono text-zinc-700">Recessed Warm LED</span>
          </div>
        </div>

        <div class="relative z-10 h-64 sm:h-72 w-full rounded-2xl overflow-hidden border border-zinc-200 group mt-2 bg-zinc-900 bg-cover bg-center" style="background-image: url('/images/services/railings-banner-poster.webp');">
          <video
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            poster="/images/services/railings-banner-poster.webp"
            aria-hidden="true"
          >
            <source src="/videos/services/railings-banner.mp4" type="video/mp4" />
          </video>
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-transparent to-transparent"></div>
          <div class="absolute bottom-3 left-3 flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-950/80 backdrop-blur-md border border-white/10 text-[10px] text-white font-mono shadow-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="tracking-wider">LIVE MOTION • STRUCTURAL BALUSTRADES</span>
          </div>
        </div>
      </div>

      <!-- Bento Card 2 (Span 4: Steel & Glass Canopies) -->
      <div class="md:col-span-4 rounded-3xl bg-white border border-zinc-200 p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden group hover:border-amber-500/70 transition-all duration-300 shadow-sm hover:shadow-xl">
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-4">
            <span class="text-[10px] font-bold text-amber-900 uppercase tracking-widest px-3 py-1 rounded-full bg-amber-50 border border-amber-200 font-mono">
              DISCIPLINE 02
            </span>
            <span class="text-[11px] font-mono text-amber-700 tracking-wider font-semibold">
              MONSOON-RATED
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 font-heading mb-3 group-hover:text-amber-800 transition-colors">
            <a href="/services/glass-canopy/">Heavy-Duty Glass &amp; Steel Canopies</a>
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 mb-5 leading-relaxed">
            Cantilevered structural steel framework paired with high-tensile spider rod fittings and laminated SentryGlas shields engineered to withstand intense coastal monsoon gusts.
          </p>
        </div>

        <div class="relative z-10 h-56 w-full rounded-2xl overflow-hidden border border-zinc-200 group mt-2 bg-zinc-900 bg-cover bg-center" style="background-image: url('/images/services/canopy-banner-poster.webp');">
          <video
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            poster="/images/services/canopy-banner-poster.webp"
            aria-hidden="true"
          >
            <source src="/videos/services/canopy-banner.mp4" type="video/mp4" />
          </video>
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-transparent to-transparent"></div>
          <div class="absolute bottom-3 left-3 flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-zinc-950/80 backdrop-blur-md border border-white/10 text-[9px] text-white font-mono shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>SPIDER CANOPY GLAZING</span>
          </div>
        </div>
      </div>

      <!-- Bento Card 3 (Span 4: Minimalist Sliding Systems) -->
      <div class="md:col-span-4 rounded-3xl bg-white border border-zinc-200 p-6 sm:p-8 flex flex-col justify-between group hover:border-amber-500/70 transition-all duration-300 shadow-sm hover:shadow-xl">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-[10px] font-bold text-amber-900 uppercase tracking-widest px-3 py-1 rounded-full bg-amber-50 border border-amber-200 font-mono">
              DISCIPLINE 03
            </span>
            <span class="text-[11px] font-mono text-amber-700 tracking-wider font-semibold">
              ACOUSTIC RW 42dB
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 font-heading mb-3 group-hover:text-amber-800 transition-colors">
            <a href="/services/windows/">Minimalist Acoustic &amp; Slim Sliding</a>
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 mb-5 leading-relaxed">
            Ultra-narrow 20mm sightline thermally broken frames, multi-point acoustic compression seals, and oversized double-glazed acoustic insulated glass units.
          </p>
        </div>
        <div class="relative h-44 w-full rounded-2xl overflow-hidden border border-zinc-200 mt-2 bg-zinc-900 bg-cover bg-center" style="background-image: url('/images/services/windows-banner-poster.webp');">
          <video
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            poster="/images/services/windows-banner-poster.webp"
            aria-hidden="true"
          >
            <source src="/videos/services/windows-banner.mp4" type="video/mp4" />
          </video>
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-transparent to-transparent"></div>
          <div class="absolute bottom-3 left-3 flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-zinc-950/80 backdrop-blur-md border border-white/10 text-[9px] text-white font-mono shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>ACOUSTIC SLIDING MOTION</span>
          </div>
        </div>
      </div>

      <!-- Bento Card 4 (Span 4: Metal & Fluted Glass Screens) -->
      <div class="md:col-span-4 rounded-3xl bg-white border border-zinc-200 p-6 sm:p-8 flex flex-col justify-between group hover:border-amber-500/70 transition-all duration-300 shadow-sm hover:shadow-xl">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-[10px] font-bold text-amber-900 uppercase tracking-widest px-3 py-1 rounded-full bg-amber-50 border border-amber-200 font-mono">
              DISCIPLINE 04
            </span>
            <span class="text-[11px] font-mono text-amber-700 tracking-wider font-semibold">
              PRECISION INTERIOR
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 font-heading mb-3 group-hover:text-amber-800 transition-colors">
            <a href="/services/interior-work/">Custom Metal &amp; Fluted Screens</a>
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 mb-5 leading-relaxed">
            Precision CNC laser-profiled stainless steel frames in brushed titanium finish, fitted with reeded, ribbed, or privacy architectural glass.
          </p>
        </div>
        <div class="relative h-44 w-full rounded-2xl overflow-hidden border border-zinc-200 mt-2">
          <img
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            src="/images/projects/project-11-interior-partition.webp"
            alt="Bespoke metal and fluted glass partition"
            loading="lazy"
            onerror="this.src='https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80'"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-900/40 to-transparent"></div>
        </div>
      </div>

      <!-- Bento Card 5 (Span 4: Structural Spider Glazing) -->
      <div class="md:col-span-4 rounded-3xl bg-white border border-zinc-200 p-6 sm:p-8 flex flex-col justify-between group hover:border-amber-500/70 transition-all duration-300 shadow-sm hover:shadow-xl">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-[10px] font-bold text-amber-900 uppercase tracking-widest px-3 py-1 rounded-full bg-amber-50 border border-amber-200 font-mono">
              DISCIPLINE 05
            </span>
            <span class="text-[11px] font-mono text-amber-700 tracking-wider font-semibold">
              STRUCTURAL FAÇADES
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 font-heading mb-3 group-hover:text-amber-800 transition-colors">
            <a href="/services/construction/">Structural Spider Glazing &amp; Facades</a>
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 mb-5 leading-relaxed">
            Point-supported glass curtain walls with heavy-duty cast 316 stainless rotules and structural steel backup trusses engineered specifically for coastal wind shears.
          </p>
        </div>
        <div class="relative h-44 w-full rounded-2xl overflow-hidden border border-zinc-200 mt-2">
          <img
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            src="/images/projects/project-12-construction-frame.webp"
            alt="Structural spider glazing and facade"
            loading="lazy"
            onerror="this.src='https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80'"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-900/40 to-transparent"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Animated Trust & Delivery Metrics Band -->
  <StatsCounter />

  <!-- 3. The 5-Step Precision Engineering Protocol -->
  <section class="py-20 lg:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-zinc-200" id="engineering">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-[11px] font-bold tracking-widest uppercase font-mono shadow-sm">
        QUALITY ASSURANCE TELEMETRY
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight font-heading">
        The 5-Step <span class="text-gradient-bronze">Precision Engineering</span> Protocol
      </h2>
      <p class="text-zinc-600 text-sm sm:text-base leading-relaxed">
        Every installation adheres to rigorous structural calculations, laser calibration, and proprietary anti-corrosion treatments built specifically for maritime environments.
      </p>
    </div>

    <!-- 5-Step Horizontal Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-14">
      <!-- Step 1 -->
      <div class="p-6 rounded-2xl bg-white border border-zinc-200 flex flex-col justify-between group hover:border-amber-400 transition-all duration-300 shadow-sm hover:shadow-lg">
        <div>
          <div class="text-3xl font-extrabold text-zinc-200 group-hover:text-amber-700 transition-colors font-mono">01</div>
          <h4 class="text-base font-bold text-zinc-900 mt-3 mb-2 font-heading">3D Laser Survey &amp; BIM</h4>
          <p class="text-xs text-zinc-500 leading-relaxed">Point-cloud site scans yielding 0.5mm tolerance accuracy prior to fabrication.</p>
        </div>
        <div class="mt-6 pt-3 border-t border-zinc-100 font-mono text-[11px] text-amber-700 font-semibold">±0.5mm Accuracy</div>
      </div>

      <!-- Step 2 -->
      <div class="p-6 rounded-2xl bg-white border border-zinc-200 flex flex-col justify-between group hover:border-amber-400 transition-all duration-300 shadow-sm hover:shadow-lg">
        <div>
          <div class="text-3xl font-extrabold text-zinc-200 group-hover:text-amber-700 transition-colors font-mono">02</div>
          <h4 class="text-base font-bold text-zinc-900 mt-3 mb-2 font-heading">CNC Laser &amp; Heavy Mill</h4>
          <p class="text-xs text-zinc-500 leading-relaxed">Fiber-laser cutting of SS 316 plates and argon-purged TIG welded joints.</p>
        </div>
        <div class="mt-6 pt-3 border-t border-zinc-100 font-mono text-[11px] text-amber-700 font-semibold">SS 316 Pure Alloys</div>
      </div>

      <!-- Step 3 -->
      <div class="p-6 rounded-2xl bg-white border border-zinc-200 flex flex-col justify-between group hover:border-amber-400 transition-all duration-300 shadow-sm hover:shadow-lg">
        <div>
          <div class="text-3xl font-extrabold text-zinc-200 group-hover:text-amber-700 transition-colors font-mono">03</div>
          <h4 class="text-base font-bold text-zinc-900 mt-3 mb-2 font-heading">FEA Wind Testing</h4>
          <p class="text-xs text-zinc-500 leading-relaxed">Computational finite element stress analysis simulating coastal cyclonic gusts.</p>
        </div>
        <div class="mt-6 pt-3 border-t border-zinc-100 font-mono text-[11px] text-amber-700 font-semibold">IS 875 Wind Standard</div>
      </div>

      <!-- Step 4 -->
      <div class="p-6 rounded-2xl bg-white border border-zinc-200 flex flex-col justify-between group hover:border-amber-400 transition-all duration-300 shadow-sm hover:shadow-lg">
        <div>
          <div class="text-3xl font-extrabold text-zinc-200 group-hover:text-amber-700 transition-colors font-mono">04</div>
          <h4 class="text-base font-bold text-zinc-900 mt-3 mb-2 font-heading">Structural Sealant</h4>
          <p class="text-xs text-zinc-500 leading-relaxed">Dow Corning structural glazing silicones applied with precision curing controls.</p>
        </div>
        <div class="mt-6 pt-3 border-t border-zinc-100 font-mono text-[11px] text-amber-700 font-semibold">Dow Corning Sealants</div>
      </div>

      <!-- Step 5 -->
      <div class="p-6 rounded-2xl bg-white border border-zinc-200 flex flex-col justify-between group hover:border-amber-400 transition-all duration-300 shadow-sm hover:shadow-lg">
        <div>
          <div class="text-3xl font-extrabold text-zinc-200 group-hover:text-amber-700 transition-colors font-mono">05</div>
          <h4 class="text-base font-bold text-zinc-900 mt-3 mb-2 font-heading">10-Year Warranty</h4>
          <p class="text-xs text-zinc-500 leading-relaxed">Official certification documentation &amp; scheduled periodic corrosion checkups.</p>
        </div>
        <div class="mt-6 pt-3 border-t border-zinc-100 font-mono text-[11px] text-amber-700 font-semibold">Certified Warranty</div>
      </div>
    </div>

    <!-- Trust Badges & Material Partner Row -->
    <div class="rounded-3xl bg-white border border-zinc-200 p-6 sm:p-8 flex flex-wrap items-center justify-around gap-6 sm:gap-8 shadow-md">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-800 shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <div class="text-sm font-bold text-zinc-900 font-heading">Saint-Gobain</div>
          <div class="text-[11px] font-mono text-zinc-500">Authorized Processing Partner</div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-800 shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <div>
          <div class="text-sm font-bold text-zinc-900 font-heading">AIS Glass</div>
          <div class="text-[11px] font-mono text-zinc-500">Certified Toughened Glazing</div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-800 shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          </svg>
        </div>
        <div>
          <div class="text-sm font-bold text-zinc-900 font-heading">Jindal Stainless</div>
          <div class="text-[11px] font-mono text-zinc-500">304 / 316 Marine Alloys</div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-800 shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <div>
          <div class="text-sm font-bold text-zinc-900 font-heading">ISO 9001:2015</div>
          <div class="text-[11px] font-mono text-zinc-500">Certified Fabrication Plant</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cinematic Full-Width Background Video Ribbon: Metallurgy & Craftsmanship -->
  <section class="relative py-24 sm:py-32 bg-zinc-950 text-white overflow-hidden my-6">
    <!-- Active Video Background -->
    <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none bg-cover bg-center" style="background-image: url('/images/about/about-poster.webp');">
      <video
        class="w-full h-full object-cover opacity-50 scale-105"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/images/about/about-poster.webp"
        aria-hidden="true"
      >
        <source src="/videos/services/about-workshop.mp4" type="video/mp4" />
      </video>
