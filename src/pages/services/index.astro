---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTABanner from '../../components/CTABanner.astro';
import { siteConfig } from '../../data/site';
import { mediaManifest } from '../../data/media';

const bannerVideo = mediaManifest.banners.railings;
const allServices = siteConfig.services;
---

<Layout
  title="Architectural Fabrication Services in Mangaluru & Surathkal"
  description="Explore Needs Group's full range of custom steel, GI, glass, wood & aluminium railings, custom windows, glass canopies, interior fitouts, and construction."
  serviceSchema={{
    name: 'Architectural Metal and Glass Fabrication Services',
    description: 'Comprehensive architectural metal balustrades, custom windows, structural glass canopies, and interior fabrication in coastal Karnataka.',
    serviceType: 'Metal Fabrication & Architectural Glazing',
  }}
  videoSchema={{
    name: bannerVideo.title,
    description: bannerVideo.description,
    thumbnailUrl: bannerVideo.poster,
    uploadDate: bannerVideo.uploadDate,
    contentUrl: bannerVideo.mp4,
  }}
>
  <!-- Page Banner with Video Background -->
  <PageBanner
    title="Architectural Metal & Glass Fabrication Services"
    subtitle="Engineered for high wind-loads and coastal saline durability. Custom stainless steel, GI, safety glass balustrades, weather-sealed windows, and canopies across Mangaluru."
    badge="11 CORE DISCIPLINES"
    video={bannerVideo}
    breadcrumbs={[{ label: 'Services' }]}
    serviceName="All Services Overview"
  />

  <!-- Main Services Directory -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 text-amber-900 border border-amber-200 text-xs font-semibold uppercase tracking-wider font-mono shadow-sm">
          COMPLETE ARCHITECTURAL SPECTRUM
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 font-heading">
          Tailored Engineering for <span class="text-gradient-bronze">Coastal Karnataka</span>
        </h2>
        <p class="text-zinc-600 text-base leading-relaxed">
          Whether you require modern frameless glass balustrades for a luxury villa in Surathkal, corrosion-proof extruded aluminium window systems in Mangaluru, or heavy-gauge galvanized iron security railings in Baikampady, Needs Group delivers master precision backed by 15 years of coastal fabrication experience.
        </p>
      </div>

      <!-- Categories Filter / Anchor Quick Jump -->
      <div class="flex flex-wrap gap-2.5 pt-2">
        <a href="#railings-group" class="px-4 py-2 rounded-full bg-zinc-50 border border-zinc-200 text-zinc-700 hover:text-amber-800 hover:border-amber-300 hover:bg-white text-xs font-semibold transition-colors font-mono shadow-sm">
          Railings (5 Varieties)
        </a>
        <a href="#windows-group" class="px-4 py-2 rounded-full bg-zinc-50 border border-zinc-200 text-zinc-700 hover:text-amber-800 hover:border-amber-300 hover:bg-white text-xs font-semibold transition-colors font-mono shadow-sm">
          Windows (3 Varieties)
        </a>
        <a href="/services/glass-canopy/" class="px-4 py-2 rounded-full bg-zinc-50 border border-zinc-200 text-zinc-700 hover:text-amber-800 hover:border-amber-300 hover:bg-white text-xs font-semibold transition-colors font-mono shadow-sm">
          Glass Canopy
        </a>
        <a href="/services/interior-work/" class="px-4 py-2 rounded-full bg-zinc-50 border border-zinc-200 text-zinc-700 hover:text-amber-800 hover:border-amber-300 hover:bg-white text-xs font-semibold transition-colors font-mono shadow-sm">
          Interior Fitouts
        </a>
        <a href="/services/construction/" class="px-4 py-2 rounded-full bg-zinc-50 border border-zinc-200 text-zinc-700 hover:text-amber-800 hover:border-amber-300 hover:bg-white text-xs font-semibold transition-colors font-mono shadow-sm">
          Construction
        </a>
      </div>

      <!-- Full Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allServices.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>

    </div>
  </section>

  <!-- Service Quality Checklist Banner -->
  <section class="py-16 bg-zinc-50/70 border-y border-zinc-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center sm:text-left">
        <div class="p-6 rounded-2xl bg-white border border-zinc-200 space-y-2 shadow-sm">
          <div class="text-amber-800 font-bold text-lg font-heading">Certified Metallurgy</div>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Genuine SS 304 and marine-grade SS 316 with test certificates to withstand heavy coastal humidity and rain.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-zinc-200 space-y-2 shadow-sm">
          <div class="text-amber-800 font-bold text-lg font-heading">Laser-Measured Accuracy</div>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Every site visit includes digital laser surveying for 100% plumb balusters and flawless window reveals.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-zinc-200 space-y-2 shadow-sm">
          <div class="text-amber-800 font-bold text-lg font-heading">Transparent Indian Rupee (₹) Pricing</div>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Direct workshop fabrication eliminates intermediary markups. Transparent per-sq-ft and running-ft pricing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final Call to Action -->
  <CTABanner
    title="Need Architectural Fabrication Advice?"
    subtitle="Our senior engineers are available for complimentary site measurements and specification guidance across Surathkal and Mangaluru."
    serviceName="General Fabrication Inquiry"
  />
</Layout>