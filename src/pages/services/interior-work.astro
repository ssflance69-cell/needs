---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import CTABanner from '../../components/CTABanner.astro';
import { mediaManifest } from '../../data/media';

const bannerVideo = mediaManifest.banners.interiorWork;
---

<Layout
  title="Interior Metal & Glass Partitions, Dividers in Mangaluru"
  description="Bespoke architectural steel & glass room dividers, fluted glass partitions, luxury staircase remodels, and turnkey interior fitouts in Surathkal & Mangaluru."
  serviceSchema={{
    name: 'Architectural Interior Metal & Glass Work',
    description: 'Custom steel and fluted glass interior partitions, acoustic dividers, floating staircases, and metal architectural elements in coastal Karnataka.',
    serviceType: 'Interior Architectural Fabrication',
  }}
  videoSchema={{
    name: bannerVideo.title,
    description: bannerVideo.description,
    thumbnailUrl: bannerVideo.poster,
    uploadDate: bannerVideo.uploadDate,
    contentUrl: bannerVideo.mp4,
  }}
>
  <PageBanner
    title="Architectural Interior Metal & Glass Fitouts"
    subtitle="Precision-crafted steel grid partitions, fluted privacy glass dividers, acoustic office cubicles, and statement metal staircases for modern coastal homes and corporate spaces."
    badge="BESPOKE ARCHITECTURAL INTERIORS"
    video={bannerVideo}
    breadcrumbs={[
      { label: 'Services', href: '/services/' },
      { label: 'Interior Work' },
    ]}
    serviceName="Interior Metal & Glass Work"
  />

  <section class="py-10 sm:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- Visual (7 Cols) - Prominent Hero Project Photo -->
        <div class="lg:col-span-7 space-y-3">
          <div class="relative rounded-2xl overflow-hidden border border-zinc-200 shadow-xl bg-zinc-100 aspect-[16/10] group">
            <img
              src="/images/services/interior-work.webp"
              alt="Modern steel and glass interior room divider fabricated in Mangaluru"
              width="1200"
              height="750"
              loading="eager"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <!-- Lightbox Zoom Trigger -->
            <button
              type="button"
              data-lightbox-trigger
              data-type="image"
              data-image="/images/services/interior-work.webp"
              data-title="Steel & Fluted Glass Room Divider"
              data-description="Custom-built black metal fluted glass partition wall in Mangaluru apartment."
              data-location="Surathkal & Mangaluru Installation"
              class="absolute top-3 right-3 p-2.5 rounded-xl bg-zinc-950/70 hover:bg-zinc-950/90 text-white border border-white/20 backdrop-blur-md transition-all shadow-md"
              title="Expand Full Photo"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
            </button>
          </div>
          <div class="p-3.5 rounded-xl bg-white border border-zinc-200 text-xs text-zinc-700 shadow-sm flex items-center justify-between">
            <div><span class="text-amber-800 font-bold">Fabrication:</span> Matte Black Steel Grid | Fluted Glass Insets | Pivot Hinges</div>
            <span class="text-zinc-400 text-[11px] hidden sm:inline">Mangaluru Interior</span>
          </div>
        </div>

        <!-- Content (5 Cols) -->
        <div class="lg:col-span-5 space-y-5">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-xs font-semibold uppercase tracking-wider shadow-sm">
              Contemporary Interiors
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 font-heading">
              Sleek Metal &amp; Glass Dividers for <span class="text-gradient-bronze">Modern Open-Plan Spaces</span>
            </h2>
            <p class="text-sm font-semibold text-amber-800">
              Balancing open-concept natural daylight with acoustic privacy
            </p>
          </div>

          <p class="text-zinc-600 text-sm sm:text-base leading-relaxed">
            Needs Group transforms residential living spaces, duplex penthouses, and commercial offices with custom-crafted architectural metal and glass interior elements. From European-inspired black-framed French doors to textured fluted glass partitions and floating staircase stringers, we bring precision engineering directly inside your home.
          </p>

          <div class="space-y-3">
            <h3 class="text-xs font-bold text-zinc-900 uppercase tracking-wider">Interior Fabrication Capabilities</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-zinc-600">
              <div class="p-3 rounded-lg bg-zinc-50 border border-zinc-200">
                <span class="text-amber-800 font-semibold block mb-1">Steel &amp; Fluted Glass Dividers:</span>
                Textured privacy glass encased in slim matte black or brass-coated steel frames for living-dining division.
              </div>
              <div class="p-3 rounded-lg bg-zinc-50 border border-zinc-200">
                <span class="text-amber-800 font-semibold block mb-1">Sliding Barn &amp; Pocket Doors:</span>
                Top-hung smooth gliding track doors with soft-close dampers, ideal for master bathrooms and walk-in wardrobes.
              </div>
              <div class="p-3 rounded-lg bg-zinc-50 border border-zinc-200">
                <span class="text-amber-800 font-semibold block mb-1">Floating Staircase Stringers:</span>
                Central spine or concealed mono-stringer steel staircases integrated with solid hardwood steps and glass balustrades.
              </div>
              <div class="p-3 rounded-lg bg-zinc-50 border border-zinc-200">
                <span class="text-amber-800 font-semibold block mb-1">Acoustic Office Cabins:</span>
                Double-glazed floor-to-ceiling sound-attenuated meeting pods and executive room partitions.
              </div>
            </div>
          </div>

          <div class="pt-2 flex flex-wrap gap-3">
            <button
              type="button"
              data-open-whatsapp
              data-service="Interior Metal & Glass Partitions"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-amber-700 via-amber-600 to-amber-800 hover:scale-[1.02] text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
              <span>Consult on Interior Partitions</span>
            </button>
            <a
              href="/contact/#enquiry-form"
              class="inline-flex items-center gap-1.5 px-5 py-3 rounded-full bg-zinc-50 border border-zinc-200 text-zinc-800 text-xs font-semibold hover:border-amber-400 uppercase tracking-wider transition-colors shadow-sm"
            >
              <span>Book Interior Measurement</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>

  <CTABanner
    title="Bring European Elegance to Your Mangaluru Interior"
    subtitle="Custom manufactured in Surathkal to fit your exact ceiling heights and wall recesses without gaps or floor damage."
    serviceName="Interior Fitout Consultation"
  />
</Layout>