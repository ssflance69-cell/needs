---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import CTABanner from '../../components/CTABanner.astro';
import { mediaManifest } from '../../data/media';

const bannerVideo = mediaManifest.banners.construction;
---

<Layout
  title="Turnkey Construction & Structural Steel in Mangaluru"
  description="Turnkey residential & commercial construction, structural steel framing, civil elevations, and heavy architectural metal works in Surathkal, Mangaluru, Karnataka."
  serviceSchema={{
    name: 'Turnkey Construction & Structural Steel Framing',
    description: 'Comprehensive civil construction, structural steel building frames, elevation fabrication, and commercial additions in coastal Karnataka.',
    serviceType: 'Construction & Civil Engineering',
  }}
  videoSchema={{
    name: bannerVideo.title,
    description: bannerVideo.description,
    thumbnailUrl: bannerVideo.poster,
    uploadDate: bannerVideo.uploadDate,
    contentUrl: bannerVideo.mp4,
  }}
>
  <PageBanner
    title="Turnkey Construction & Structural Steel Framing"
    subtitle="End-to-end civil execution, heavy structural steel column and truss fabrication, architectural elevation facades, and commercial building expansions across coastal Karnataka."
    badge="CIVIL & STRUCTURAL ENGINEERING"
    video={bannerVideo}
    breadcrumbs={[
      { label: 'Services', href: '/services/' },
      { label: 'Construction' },
    ]}
    serviceName="Construction & Structural Works"
  />

  <section class="py-16 sm:py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <!-- Visual (5 Cols) -->
        <div class="lg:col-span-5 space-y-4">
          <div class="rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900 aspect-[4/3]">
            <img
              src="/images/services/construction.webp"
              alt="Turnkey residential and commercial structural steel construction in Mangaluru"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-300">
            <span class="text-amber-400 font-semibold">Civil Capabilities:</span> Structural I-Beam Framing | Pre-Engineered Buildings (PEB) | Architectural Metal Elevation Cladding | Turnkey Villas
          </div>
        </div>

        <!-- Content (7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold uppercase tracking-wider">
              TOTAL STRUCTURAL INTEGRITY
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-heading">
              Built for Heavy Coastal Weather and Dynamic Loads
            </h2>
            <p class="text-sm font-medium text-amber-400/90">
              Integrated fabrication and civil execution under one unified management
            </p>
          </div>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Unlike standard contractors who subcontract metal fabrication and glazing to third parties, Needs Group unites heavy civil engineering with in-house master metal fabrication. This eliminates misalignment between concrete frames and architectural metal railings, windows, and canopies—resulting in faster handover and zero contractor disputes.
          </p>

          <div class="space-y-3">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider">Key Construction Services</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-300">
              <div class="p-3 rounded-lg bg-slate-900 border border-slate-800">
                <span class="text-amber-400 font-semibold block mb-1">Structural Steel PEB Framing:</span>
                Pre-engineered buildings, heavy industrial sheds, mezzanine floors, and commercial showroom steel structures.
              </div>
              <div class="p-3 rounded-lg bg-slate-900 border border-slate-800">
                <span class="text-amber-400 font-semibold block mb-1">Turnkey Villa Construction:</span>
                From foundation excavation in Surathkal coastal soils to structural masonry, slab casting, and finishing.
              </div>
              <div class="p-3 rounded-lg bg-slate-900 border border-slate-800">
                <span class="text-amber-400 font-semibold block mb-1">Architectural Elevation Facades:</span>
                Exterior composite panels, structural louvers, perforated metal sunscreens, and double-glazed curtain walls.
              </div>
              <div class="p-3 rounded-lg bg-slate-900 border border-slate-800">
                <span class="text-amber-400 font-semibold block mb-1">Rooftop Extensions & Trusses:</span>
                Tubular steel roof trusses, insulated profile sheet roofing, and high wind-resistant terrace enclosures.
              </div>
            </div>
          </div>

          <div class="pt-2 flex flex-wrap gap-3">
            <button
              type="button"
              data-open-whatsapp
              data-service="Construction & Structural Projects"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-xs shadow-md transition-all"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
              <span>Discuss Construction Requirements</span>
            </button>
            <a
              href="/contact/#enquiry-form"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-slate-200 text-xs font-semibold hover:border-slate-600 transition-colors"
            >
              <span>Request Structural Feasibility Visit</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>

  <CTABanner
    title="Plan Your Structural Construction in Mangaluru"
    subtitle="Our civil engineers and master fabricators will conduct a full site survey, structural load review, and provide a comprehensive milestone estimate in ₹."
    serviceName="Construction Project Consultation"
  />
</Layout>
