---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import CTABanner from '../../components/CTABanner.astro';
import { mediaManifest } from '../../data/media';

const bannerVideo = mediaManifest.banners.glassCanopy;
---

<Layout
  title="Architectural Glass Canopies in Mangaluru & Surathkal"
  description="Precision engineered laminated safety glass canopies with marine-grade SS 316 spider fittings, cantilevered steel brackets, and monsoon drainage for Mangaluru buildings."
  serviceSchema={{
    name: 'Architectural Glass Canopy Fabrication & Installation',
    description: 'Custom laminated architectural glass canopies, cantilevered entrance roofs, and stainless steel spider fittings in coastal Karnataka.',
    serviceType: 'Structural Glass Canopy Glazing',
  }}
  videoSchema={{
    name: bannerVideo.title,
    description: bannerVideo.description,
    thumbnailUrl: bannerVideo.poster,
    uploadDate: bannerVideo.uploadDate,
    contentUrl: bannerVideo.mp4,
  }}
>
  <PageBanner
    title="Architectural Glass Canopies & Entrance Glazing"
    subtitle="Engineered with PVB/SentryGlas laminated safety glass and stainless steel spider fittings. Designed to shield building entrances while maximizing natural coastal sunlight."
    badge="STRUCTURAL GLAZING SPECIALISTS"
    video={bannerVideo}
    breadcrumbs={[
      { label: 'Services', href: '/services/' },
      { label: 'Glass Canopy' },
    ]}
    serviceName="Glass Canopy"
  />

  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <!-- Visual (5 Cols) -->
        <div class="lg:col-span-5 space-y-4">
          <div class="rounded-2xl overflow-hidden border border-zinc-200 shadow-xl bg-zinc-100 aspect-[4/3]">
            <img
              src="/images/services/glass-canopy.webp"
              alt="Architectural structural glass canopy over entrance in Surathkal, Mangaluru"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-zinc-700 font-mono shadow-sm">
            <span class="text-amber-800 font-bold">Technical Highlights:</span> 13.52mm / 17.52mm Laminated Safety Glass | Marine SS 316 Spider Fittings | Concealed Rain Gutters
          </div>
        </div>

        <!-- Content (7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-xs font-semibold uppercase tracking-wider font-mono shadow-sm">
              ELEGANCE MEETS PROTECTION
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 font-heading">
              Contemporary Entrance Canopies Built for <span class="text-gradient-bronze">Coastal Weather</span>
            </h2>
            <p class="text-sm font-semibold text-amber-800 font-mono">
              Cantilevered, tie-rod suspended, or structural steel post supported
            </p>
          </div>

          <p class="text-zinc-600 text-sm sm:text-base leading-relaxed">
            A glass canopy makes an unforgettable architectural first impression while providing essential weather shielding against Mangaluru's heavy monsoons and intense sun. At Needs Group, every canopy is structurally engineered for coastal wind-load pressures, using multi-layer laminated toughened glass held by precision-cast SS 316 spider brackets and articulating routels.
          </p>

          <div class="space-y-3">
            <h3 class="text-xs font-bold text-zinc-900 uppercase tracking-wider font-mono">Engineering Features</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-zinc-700">
              <div class="p-3 rounded-lg bg-zinc-50 border border-zinc-200 flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-amber-700 mt-1 shrink-0"></span>
                <span><strong class="text-zinc-900">SentryGlas / PVB Interlayers:</strong> Glass panels remain completely secure and intact even under extreme accidental impact.</span>
              </div>
              <div class="p-3 rounded-lg bg-zinc-50 border border-zinc-200 flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-amber-700 mt-1 shrink-0"></span>
                <span><strong class="text-zinc-900">Marine SS 316 Hardware:</strong> Solid cast spider fittings and tension rods engineered to resist saltwater oxidation.</span>
              </div>
              <div class="p-3 rounded-lg bg-zinc-50 border border-zinc-200 flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-amber-700 mt-1 shrink-0"></span>
                <span><strong class="text-zinc-900">Integrated Monsoon Drainage:</strong> Custom slope geometry and concealed perimeter gutter profiles for efficient water dispersal.</span>
              </div>
              <div class="p-3 rounded-lg bg-zinc-50 border border-zinc-200 flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-amber-700 mt-1 shrink-0"></span>
                <span><strong class="text-zinc-900">Solar &amp; UV Control Tints:</strong> Available in crystal clear, ceramic frit pattern, bronze, or soft grey solar-reducing tints.</span>
              </div>
            </div>
          </div>

          <div class="pt-2 flex flex-wrap gap-3">
            <button
              type="button"
              data-open-whatsapp
              data-service="Glass Canopy Systems"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-amber-700 via-amber-600 to-amber-800 hover:scale-[1.02] text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
              <span>Request Canopy Design &amp; Quote</span>
            </button>
            <a
              href="/contact/#enquiry-form"
              class="inline-flex items-center gap-1.5 px-5 py-3 rounded-full bg-zinc-50 border border-zinc-200 text-zinc-800 text-xs font-semibold hover:border-amber-400 uppercase tracking-wider transition-colors shadow-sm"
            >
              <span>Schedule Canopy Site Inspection</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>

  <CTABanner
    title="Transform Your Property Entrance with Architectural Glazing"
    subtitle="Our structural engineers calculate exact bracket loads and glass thicknesses for your Surathkal or Mangaluru property."
    serviceName="Glass Canopy Project Consultation"
  />
</Layout>