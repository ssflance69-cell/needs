---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import CTABanner from '../../components/CTABanner.astro';
import { mediaManifest } from '../../data/media';

const bannerVideo = mediaManifest.banners.railings;

const railingTypes = [
  {
    id: 'steel-railing',
    name: 'Steel Railing (SS 304 & SS 316)',
    subtitle: 'Marine-grade stainless steel engineered for coastal rust resistance',
    image: '/images/services/steel-railing.webp',
    alt: 'Grade 304 and 316 stainless steel railings fabricated in Surathkal, Mangaluru',
    description:
      'Our stainless steel railings are custom-fabricated from certified SS 304 and SS 316 tubes, flat bars, and solid rods. Featuring seamless argon TIG welding, invisible joint grinding, and precision satin or mirror-buffed finishes, these balustrades resist pitting and oxidation even in beachfront locations across Mangaluru.',
    benefits: [
      'High resistance to saline coastal corrosion (marine-grade SS 316 available)',
      'High tensile strength with robust impact absorption for balconies and staircases',
      'Minimal maintenance requirements with easily cleanable polished or satin textures',
      'Custom fabricated with round, square, or slotted top handrails',
    ],
    bestUseCases: [
      'Beachfront villas, coastal apartments, and portico balconies in Surathkal',
      'Internal and external duplex staircases, ramps, and terrace parapets',
      'Commercial office complexes and shopping complexes requiring high-durability balustrades',
    ],
    specs: 'SS 304 / SS 316 | 1.5mm to 3.0mm wall thickness | Mirror / Satin brush finish',
  },
  {
    id: 'gi-railing',
    name: 'GI Railing (Galvanized Iron)',
    subtitle: 'Heavy-duty galvanized balustrades with architectural powder coating',
    image: '/images/services/gi-railing.webp',
    alt: 'Galvanized iron GI railing with industrial powder coating in Mangaluru',
    description:
      'Galvanized Iron (GI) railings offer heavy structural rigidity and anti-vandal resistance at an economical price point. Each balustrade undergoes hot-dip galvanizing or heavy zinc priming followed by electrostatic thermoset powder coating in matte black, charcoal grey, bronze, or custom RAL shades.',
    benefits: [
      'Maximum structural rigidity and resistance against heavy physical impact',
      'Multi-stage zinc coating prevents red rust formation in high-rainfall coastal monsoons',
      'High versatility in geometric, contemporary, or traditional decorative grill patterns',
      'Economical lifecycle cost for large boundary walls and commercial perimeters',
    ],
    bestUseCases: [
      'External boundary walls, compound perimeters, and driveway safety gates',
      'Terrace safety enclosures and industrial catwalk railings in Baikampady',
      'Residential housing societies seeking rugged security and low maintenance',
    ],
    specs: 'Hot-dip galvanized hollow sections | Zinc phosphate primer | 70+ micron powder coat',
  },
  {
    id: 'glass-railing',
    name: 'Glass Railing (Frameless & Spigot Systems)',
    subtitle: 'Panoramic toughened and laminated safety glass with zero visual barriers',
    image: '/images/services/glass-railing.webp',
    alt: 'Frameless toughened safety glass railing installed in Surathkal home',
    description:
      'Engineered for luxury modern architecture, our glass railings utilize 12mm to 19mm toughened safety glass or PVB laminated architectural glass. Mounted using continuous aluminium base-shoe channels, marine SS 316 floor spigots, or side-mounted standoff brackets, they deliver uninterrupted ocean views and clean minimalist lines.',
    benefits: [
      '100% unobstructed panoramic views of coastal scenery and landscaped gardens',
      'Extreme safety: heat-tempered glass will not break under standard human impact',
      'Laminated glass options ensure panels stay in place even if fractured',
      'Sleek modern aesthetics that significantly increase property resale value',
    ],
    bestUseCases: [
      'Luxury residential balconies, penthouse terraces, and infinity pool borders',
      'Internal floating staircases, mezzanine gallery balustrades, and atriums',
      'Boutique commercial hotels, oceanfront restaurants, and retail showrooms',
    ],
    specs: '12mm / 15mm Toughened or 13.52mm / 17.52mm PVB Laminated | SS 316 Spigots',
  },
  {
    id: 'wood-railing',
    name: 'Wood Railing (Teak & Hardwood Hybrid)',
    subtitle: 'Warm luxury hardwood handrails paired with stainless steel or glass inserts',
    image: '/images/services/wood-railing.webp',
    alt: 'Handcrafted teak wood handrail with stainless steel balusters in Mangaluru',
    description:
      'Combining the organic warmth of seasoned natural teak, mahogany, or rosewood with modern steel or glass infills, our wood railings provide a tactile, opulent interior statement. Every handrail is vacuum-treated against coastal humidity, sanded silky smooth, and finished in polyurethane matte or high-gloss coatings.',
    benefits: [
      'Warm, ergonomic grip feel that synthetic materials cannot replicate',
      'Natural grain patterns adding timeless architectural richness to residential interiors',
      'Seamlessly integrates with both contemporary minimalist and traditional Mangalorean homes',
      'Treated with insecticidal and anti-fungal sealants against coastal moisture',
    ],
    bestUseCases: [
      'Luxury residential internal stairways and villa entrance lobbies',
      'Duplex upper-level landing galleries and loft balconies',
      'Heritage bungalow renovations and premium executive suites',
    ],
    specs: 'Seasoned Teak / Hardwood | Multi-coat Polyurethane sealer | Integrated SS inserts',
  },
  {
    id: 'aluminium-railing',
    name: 'Aluminium Railing (Modular & Corrosion-Proof)',
    subtitle: 'Lightweight extruded aluminium balustrades with anodized or powder finishes',
    image: '/images/services/aluminium-railing.webp',
    alt: 'Modular extruded aluminium railing installed in coastal Karnataka villa',
    description:
      'Manufactured from high-grade 6063-T6 architectural aluminium (also searched as aluminum), these modular railing systems offer zero corrosion risk even in extreme saltwater conditions. Their lightweight structure reduces dead-load on building balconies while delivering high structural deflection resistance.',
    benefits: [
      '100% immune to rust—ideal for coastal properties facing continuous salt air',
      'Significant reduction in structural dead weight on cantilevered balconies',
      'Anodized (up to 25 microns) or architectural Qualicoat powder finishes',
      'Rapid modular installation without on-site hot work or welding fumes',
    ],
    bestUseCases: [
      'Multi-storey coastal apartment balconies in Mangaluru and Surathkal',
      'Hospitality resorts, ocean-facing guest houses, and swimming pool fences',
      'Terraces requiring lightweight, zero-maintenance balustrades',
    ],
    specs: 'Alloy 6063-T6 | 20-25 micron Anodized / Qualicoat powder finish | Modular brackets',
  },
];
---

<Layout
  title="Steel, GI, Glass, Wood & Aluminium Railings in Mangaluru"
  description="Master fabrication of SS 304/316, galvanized GI, frameless toughened glass, wood, and aluminium railings across Surathkal, Mangaluru, and coastal Karnataka."
  serviceSchema={{
    name: 'Architectural Railing Fabrication & Installation',
    description: 'Precision fabrication of stainless steel, GI, toughened glass balustrades, wood handrails, and aluminium railing systems.',
    serviceType: 'Railing & Balustrade Fabrication',
  }}
  videoSchema={{
    name: bannerVideo.title,
    description: bannerVideo.description,
    thumbnailUrl: bannerVideo.poster,
    uploadDate: bannerVideo.uploadDate,
    contentUrl: bannerVideo.mp4,
  }}
>
  <!-- Page Banner with Video Background -->
  <PageBanner
    title="Architectural Railings: Steel, GI, Glass, Wood & Aluminium"
    subtitle="Engineered for high wind-resistance, safety compliance, and zero coastal corrosion. 900+ completed installations across Surathkal, Mangaluru, and coastal Karnataka."
    badge="900+ COMPLETED RAILING PROJECTS"
    video={bannerVideo}
    breadcrumbs={[
      { label: 'Services', href: '/services/' },
      { label: 'Railings' },
    ]}
    serviceName="Architectural Railings"
  />

  <!-- Quick Railing Type Anchor Jump -->
  <div class="bg-white/90 border-b border-zinc-200 sticky top-20 z-30 backdrop-blur-md shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 overflow-x-auto scrollbar-none flex items-center gap-2">
      <span class="text-xs font-bold text-amber-800 uppercase tracking-wider shrink-0 mr-2 font-mono">Jump To:</span>
      {railingTypes.map((r) => (
        <a
          href={`#${r.id}`}
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-zinc-50 border border-zinc-200 hover:border-amber-400 text-zinc-700 hover:text-amber-800 transition-colors shrink-0 font-mono shadow-sm"
        >
          {r.name.split(' (')[0]}
        </a>
      ))}
    </div>
  </div>

  <!-- Detailed Sections for Each Railing Type -->
  <section class="py-16 sm:py-24 bg-white space-y-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-28">
      {railingTypes.map((item, index) => (
        <div
          id={item.id}
          class="scroll-mt-36 pt-6 border-t border-zinc-200 first:border-t-0 first:pt-0"
        >
          <div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center ${index % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
            
            <!-- Visual Card (5 Cols) -->
            <div class={`lg:col-span-5 space-y-4 ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
              <div class="relative rounded-2xl overflow-hidden border border-zinc-200 shadow-xl bg-zinc-100 group aspect-[4/3]">
                <img
                  src={item.image}
                  alt={item.alt}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-900/60 via-transparent to-transparent"></div>
                <div class="absolute bottom-4 left-4 right-4 p-3 rounded-xl bg-white/90 backdrop-blur-md border border-zinc-200 text-[11px] text-zinc-800 font-mono shadow-sm">
                  <span class="text-amber-800 font-bold">Specs:</span> {item.specs}
                </div>
              </div>

              <!-- Secondary trigger for lightbox inspection -->
              <div class="flex items-center justify-between text-xs text-zinc-500 px-1 font-mono">
                <span>Fabricated in Surathkal Workshop</span>
                <button
                  type="button"
                  data-lightbox-trigger
                  data-type="image"
                  data-image={item.image}
                  data-title={item.name}
                  data-description={item.description}
                  data-location="Surathkal, Mangaluru"
                  class="text-amber-700 hover:underline flex items-center gap-1 font-semibold"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                  <span>Zoom Image</span>
                </button>
              </div>
            </div>

            <!-- Content Details (7 Cols) -->
            <div class={`lg:col-span-7 space-y-6 ${index % 2 === 1 ? 'lg:order-1' : ''}`}>
              <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-xs font-semibold uppercase tracking-wider font-mono shadow-sm">
                  0{index + 1} • RAILING CATEGORY
                </div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 font-heading">
                  {item.name}
                </h2>
                <p class="text-sm font-semibold text-amber-800 font-mono">
                  {item.subtitle}
                </p>
              </div>

              <p class="text-zinc-600 text-sm sm:text-base leading-relaxed">
                {item.description}
              </p>

              <!-- Benefits List -->
              <div class="space-y-2.5">
                <h3 class="text-xs font-bold text-zinc-900 uppercase tracking-wider font-mono">Key Engineering Advantages</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-zinc-700">
                  {item.benefits.map((b) => (
                    <div class="flex items-start gap-2 bg-zinc-50 p-2.5 rounded-lg border border-zinc-200">
                      <svg class="w-4 h-4 text-amber-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{b}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Best Use Cases -->
              <div class="space-y-2">
                <h3 class="text-xs font-bold text-zinc-500 uppercase tracking-wider font-mono">Recommended Applications</h3>
                <ul class="space-y-1.5 text-xs text-zinc-600">
                  {item.bestUseCases.map((u) => (
                    <li class="flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-700"></span>
                      <span>{u}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- CTA Row -->
              <div class="pt-2 flex flex-wrap items-center gap-3">
                <button
                  type="button"
                  data-open-whatsapp
                  data-service={item.name}
                  class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-amber-700 via-amber-600 to-amber-800 hover:scale-[1.02] text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
                  <span>Quote for {item.name.split(' (')[0]}</span>
                </button>

                <a
                  href="/contact/#enquiry-form"
                  class="inline-flex items-center gap-1.5 px-5 py-3 rounded-full bg-zinc-50 border border-zinc-200 hover:border-amber-400 text-zinc-800 text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm"
                >
                  <span>Book Site Measurement</span>
                  <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <CTABanner
    title="Custom Railings Built for Your Floor Plan"
    subtitle="Send your architectural drawings or balcony photos to our WhatsApp team for immediate feedback and cost estimation in Indian Rupees (₹)."
    serviceName="Railing Specification Inquiry"
  />
</Layout>