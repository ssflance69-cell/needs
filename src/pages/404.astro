---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found (404)"
  description="The page you are looking for does not exist or has been moved."
  noindex={true}
>
  <section class="py-24 sm:py-32 bg-white flex items-center justify-center min-h-[60vh]">
    <div class="max-w-xl mx-auto px-4 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-xs font-semibold uppercase tracking-wider font-mono shadow-sm">
        ERROR 404
      </div>

      <h1 class="text-6xl sm:text-7xl font-black text-zinc-900 font-heading tracking-tight">
        4<span class="text-amber-700">0</span>4
      </h1>

      <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 font-heading">
        Page Not Found
      </h2>

      <p class="text-sm text-zinc-600 leading-relaxed">
        The architectural page you were looking for doesn't exist, has been relocated, or is undergoing precision maintenance.
      </p>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="px-6 py-3 rounded-full bg-gradient-to-r from-amber-700 via-amber-600 to-amber-800 text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all hover:scale-[1.02]"
        >
          Return to Home
        </a>

        <a
          href="/services/"
          class="px-6 py-3 rounded-full bg-zinc-50 border border-zinc-200 hover:border-amber-400 text-zinc-800 text-xs font-semibold uppercase tracking-wider transition-all shadow-sm"
        >
          Explore Services
        </a>

        <button
          type="button"
          data-open-whatsapp
          class="px-6 py-3 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 hover:bg-emerald-100 text-xs font-semibold uppercase tracking-wider transition-all shadow-sm"
        >
          Chat with Us
        </button>
      </div>

      <div class="text-xs text-zinc-400 font-mono pt-6">
        Needs Group • Surathkal, Mangaluru, Karnataka
      </div>
    </div>
  </section>
</Layout>