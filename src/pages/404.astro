---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found (404)"
  description="The page you are looking for does not exist or has been moved."
  noindex={true}
>
  <section class="py-24 sm:py-32 bg-slate-950 flex items-center justify-center min-h-[60vh]">
    <div class="max-w-xl mx-auto px-4 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold uppercase tracking-wider">
        ERROR 404
      </div>

      <h1 class="text-6xl sm:text-7xl font-black text-white font-heading tracking-tight">
        4<span class="text-amber-400">0</span>4
      </h1>

      <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">
        Page Not Found
      </h2>

      <p class="text-sm text-slate-300 leading-relaxed">
        The architectural page you were looking for doesn't exist, has been relocated, or is undergoing precision maintenance.
      </p>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm shadow-glow transition-all"
        >
          Return to Home
        </a>

        <a
          href="/services/"
          class="px-5 py-3 rounded-xl bg-slate-900 border border-slate-700 hover:border-slate-600 text-slate-200 text-sm font-semibold transition-all"
        >
          Explore Services
        </a>

        <button
          type="button"
          data-open-whatsapp
          class="px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold transition-all"
        >
          Chat with Us
        </button>
      </div>

      <div class="text-xs text-slate-500 pt-6">
        Needs Group • Surathkal, Mangaluru, Karnataka
      </div>
    </div>
  </section>
</Layout>
