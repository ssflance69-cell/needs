---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import CTABanner from '../components/CTABanner.astro';
import { mediaManifest } from '../data/media';

const bannerVideo = mediaManifest.banners.railings;

export interface SalesCategory {
  id: string;
  name: string;
  subtitle: string;
  badge: string;
  image: string;
  alt: string;
  specs: string;
  description: string;
  highlights: string[];
  bestUseCases: string[];
  availableFinishes: string;
  standardSizes: string;
}

const salesCategories: SalesCategory[] = [
  {
    id: 'round-pipes',
    name: 'Round Pipes',
    subtitle: 'SS 304 Grade Sleek, Ergonomic Handrail & Baluster Circular Tubing',
    badge: 'Round Pipes',
    image: '/images/sales/ss-round-pipes.webp',
    alt: 'Premium SS 304 grade round stainless steel railing pipes in Surathkal workshop',
    specs: 'OD 16mm, 19mm, 25mm, 38mm, 50.8mm (2"), 63.5mm | Wall: 1.2mm, 1.5mm, 2.0mm | 6m (20ft) Length',
    description:
      'High-grade SS 304 circular tubing engineered for comfortable tactile hand grip, seamless curves, and structural integrity. Extensively used across Mangaluru, Surathkal, and Udupi for luxury residential balconies, staircase balustrades, and institutional handrails.',
    highlights: [
      'Uniform outer circumference ensuring flawless sleeve, elbow, and connector fitment',
      'High-purity 304 metallurgy resisting coastal atmospheric oxidation and staining',
      'Available in 600# Mirror Polish (high-gloss chrome luster) and 320# Satin Hairline brush',
      'True gauge wall thickness guaranteed with genuine steel mill test certificates',
    ],
    bestUseCases: [
      'Staircase handrails, wall-mounted ramp grab rails, and balustrade top-rails',
      'Horizontal multi-line infill safety barriers and intermediate balusters',
      'Commercial lobby handrails, hospital corridor rails, and entrance ramps',
    ],
    availableFinishes: '600# Mirror Polish | 320# Satin Hairline Brush',
    standardSizes: '16mm to 63.5mm OD | 6 Meter (20 Feet) standard lengths',
  },
  {
    id: 'square-pipes',
    name: 'Square Pipes',
    subtitle: 'SS 304 Grade Sharp Architectural Box & Rectangular Sections',
    badge: 'Square Pipes',
    image: '/images/sales/ss-square-pipes.webp',
    alt: 'Premium SS 304 grade square and rectangular stainless steel railing box pipes',
    specs: 'Sizes: 12x12mm, 25x25mm, 40x40mm, 50x50mm, 60x40mm, 80x40mm | Wall: 1.2mm–2.5mm | 6m Length',
    description:
      'Precision cold-formed square (SHS) and rectangular (RHS) stainless steel 304 hollow sections. Characterized by crisp 90° miter corners and high torsional stiffness, making them the benchmark for modern minimalist railing posts, privacy screens, and gate framing.',
    highlights: [
      'Crisp, flat exterior planes providing sharp architectural definition for modern villas',
      'High moment of inertia for superior post rigidity and zero railing vibration',
      'Smooth, non-porous surface finish that resists coastal dirt and salt adhesion',
      'Precision cut-to-length and miter cutting available at our Surathkal workshop',
    ],
    bestUseCases: [
      'Heavy-duty vertical balustrade posts and corner uprights',
      'Minimalist horizontal slat infills and modern compound gate frames',
      'Architectural pergola rafters, boundary dividers, and terrace screens',
    ],
    availableFinishes: '320# Satin Hairline | 600# Mirror Finish',
    standardSizes: '12x12mm up to 80x40mm | 6 Meter (20 Feet) standard lengths',
  },
  {
    id: 'slotted-pipes',
    name: 'Slotted Pipes',
    subtitle: 'SS 304 Grade Continuous Capping Channels for Glass Balustrades',
    badge: 'Slotted Pipes',
    image: '/images/sales/ss-slotted-pipes.webp',
    alt: 'Stainless steel 304 slotted handrail pipes for frameless glass railings',
    specs: 'Round (42.4mm / 50.8mm) & Square (40x40mm / 60x40mm) | Slot Width: 14mm–20mm for 10mm–17.52mm Glass',
    description:
      'Specialized stainless steel 304 handrail tubes manufactured with a continuous bottom channel. Designed to cap directly over the top edge of toughened and laminated glass balustrades, providing mandatory handrail continuity while shielding glass edges from accidental impacts.',
    highlights: [
      'Precision CNC-milled slot with EPDM rubber gasket channel for cushioned, rattle-free glass grip',
      'No through-glass hole drilling required—preserves 100% of the tempered glass strength',
      'Reinforces glass panels into one continuous, unified structural balustrade run',
      'Available with matching slotted 90° elbows, wall flanges, and flush end-caps',
    ],
    bestUseCases: [
      'Frameless glass balcony balustrades, oceanfront terraces, and rooftop decks',
      'Luxury villa staircase glass handrail capping',
      'Commercial mall atrium balustrades and corporate glass railings',
    ],
    availableFinishes: 'Satin Hairline | Mirror Polish | Matte Jet Black (PVD/Coated)',
    standardSizes: 'Fits 10mm, 12mm, 13.52mm & 17.52mm Toughened/Laminated Glass',
  },
  {
    id: 'custom-profiles',
    name: 'Custom-designed Stainless Steel Profiles',
    subtitle: 'SS 304 Grade Tailored Architectural Shapes & Laser-Cut Sections',
    badge: 'Custom SS Profiles',
    image: '/images/sales/ss-custom-profiles.webp',
    alt: 'Custom-designed stainless steel 304 architectural profiles fabricated in Surathkal',
    specs: 'Custom Radii, Bends, CNC Laser Cuts & Profiles | Thickness: 1.5mm to 6.0mm | Tailored to CAD',
    description:
      'Bespoke stainless steel 304 architectural profiles engineered and formed to custom blueprints. Using precision CNC hydraulic press-brake bending, laser contouring, and automated edge chamfering, we create custom shapes that cannot be sourced off standard shelves.',
    highlights: [
      'Fabricated strictly to architectural drawings, site measurements, and custom CAD files',
      'Custom base shoe covers, grooved reveal profiles, and decorative baluster fins',
      'Uniform corner bends and laser-clean miter cuts with zero tooling marks',
      'Available in specialized PVD titanium finishes: Brass Gold, Rose Gold, Bronze, and Black',
    ],
    bestUseCases: [
      'Signature villa entrance railings, custom handrail brackets, and post shoes',
      'Architectural facade trims, canopy support ribs, and decorative louvers',
      'High-end interior metal dividers and luxury duplex staircase elements',
    ],
    availableFinishes: 'Custom Hairline | Mirror | PVD Titanium Gold / Bronze / Black',
    standardSizes: 'Manufactured to custom project dimensions & schedules',
  },
  {
    id: 'ss-fittings',
    name: 'SS 304 Railing Fittings & Hardware',
    subtitle: 'Investment-Cast Flanges, Elbows, Connectors, End Caps & Brackets',
    badge: 'SS 304 Cast Fittings',
    image: '/images/sales/ss-railing-fittings.webp',
    alt: 'SS 304 grade railing hardware, connectors, elbows, base plates, and glass clamps',
    specs: 'Solid Investment Cast 304 | Flanges, 90°/135° Elbows, Adjustable Connectors, End Caps, Glass Clamps',
    description:
      'Complete modular connection hardware manufactured from solid investment-cast SS 304. Designed for tight, flush-fitting assembly with our round, square, and slotted pipes, enabling clean, weld-free or concealed-weld installations with maximum structural strength.',
    highlights: [
      'Solid investment-cast components ensuring zero porosity and superior tensile load tolerance',
      'Heavy-duty floor base plates and aesthetic snap-on base cover flanges',
      'Swiveling stair-angle connectors, flush 90° elbows, and architectural end caps',
      'Glass-mounting D-clamps, point fixings, and adjustable wall handrail brackets',
    ],
    bestUseCases: [
      'Rapid, weld-free modular railing installation on residential and commercial sites',
      'Heavy base plate anchoring into concrete slabs and stringer beams',
      'Staircase handrail turning transitions and wall-mounted returns',
    ],
    availableFinishes: 'Mirror 600# | Satin Hairline 320#',
    standardSizes: 'Matching standard pipe ODs: 38mm, 50.8mm, 40x40mm, 50x50mm',
  },
];

const perks = [
  {
    title: 'High-Quality SS 304 Grade',
    description: 'Direct sourcing with genuine test certificates. 18% Chromium, 8% Nickel austenitic composition for proven coastal durability.',
  },
  {
    title: 'Elegant Surface Finishes',
    description: 'Available in flawless 600# Mirror Polish (high-shine chrome luster) and contemporary 320# Satin Hairline brush.',
  },
  {
    title: 'Custom Cut & Profiling',
    description: 'In-house workshop cutting, mitering, and custom profile forming in Surathkal—delivered ready for immediate installation.',
  },
  {
    title: 'Wholesale & Retail Supply',
    description: 'We cater to single-villa home renovation requirements as well as bulk contractor consignments across coastal Karnataka.',
  },
];

const faqs = [
  {
    q: 'Why is SS 304 the standard choice for architectural railings?',
    a: 'SS 304 contains a robust blend of 18% chromium and 8% nickel. This metallurgical combination forms an invisible, self-healing passive chromium oxide film that shields the metal from oxygen, moisture, and daily wear, providing decades of maintenance-free service with simple periodic cleaning.',
  },
  {
    q: 'What is the advantage of Slotted Handrail Pipes for glass balustrades?',
    a: 'Slotted pipes feature a continuous CNC groove lined with an EPDM rubber gasket. They fit over the top edge of 10mm or 12mm toughened glass without drilling any holes in the glass, tying multiple glass panels into a unified, rigid railing run while preventing accidental edge chipping.',
  },
  {
    q: 'Can pipes be cut to my specific staircase and balcony dimensions?',
    a: 'Yes! Our Surathkal workshop is equipped with precision cold-cut saws and CNC equipment. Submit your cut list or architectural drawings, and we will deliver pipes cut, deburred, and numbered to your exact required lengths to save on-site labor and eliminate scrap.',
  },
  {
    q: 'What finishes are available in SS 304 railing materials?',
    a: 'We supply two primary finishes: 600# Mirror Polish (ultra-reflective, chrome-like shine that naturally sheds coastal rain) and 320# Satin Hairline (a modern, brushed matte texture that conceals fingerprints). Custom PVD titanium gold, bronze, and black coatings are also available for luxury interior profiles.',
  },
];
---

<Layout
  title="Premium Stainless Steel Railing Materials | SS 304 Pipes & Fittings – Needs Group"
  description="We specialize in all types of premium SS 304 Grade Railing Pipes and Fittings: Round Pipes, Square Pipes, Slotted Pipes, Custom-designed SS Profiles, and Hardware in Surathkal & Mangaluru."
  videoSchema={{
    name: bannerVideo.title,
    description: bannerVideo.description,
    thumbnailUrl: bannerVideo.poster,
    uploadDate: bannerVideo.uploadDate,
    contentUrl: bannerVideo.mp4,
  }}
>
  <!-- Page Banner -->
  <PageBanner
    title="Premium Stainless Steel Railing Materials"
    subtitle="We specialize in all types of premium SS 304 Grade Railing Pipes and Fittings: Round Pipes, Square Pipes, Slotted Pipes, and Custom-Designed Stainless Steel Profiles."
    badge="SS 304 GRADE SPECIALIST"
    video={bannerVideo}
    breadcrumbs={[{ label: 'Sales & Materials' }]}
    serviceName="SS 304 Railing Materials Inquiry"
  />

  <!-- Quick Category Anchor Jump Bar -->
  <div class="bg-white/95 border-b border-zinc-200/90 sticky top-20 z-30 backdrop-blur-md shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 overflow-x-auto scrollbar-none flex items-center gap-2">
      <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider shrink-0 mr-2">Materials:</span>
      {salesCategories.map((c) => (
        <a
          href={`#${c.id}`}
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-zinc-50 border border-zinc-200 hover:border-emerald-400 text-zinc-700 hover:text-emerald-800 transition-colors shrink-0 shadow-xs"
        >
          {c.name.split(' (')[0].trim()}
        </a>
      ))}
    </div>
  </div>

  <!-- Main Materials Catalog Section with Architectural Textured Backdrop -->
  <section class="relative py-16 sm:py-24 bg-gradient-to-b from-zinc-100/90 via-slate-50 to-zinc-100/80 overflow-hidden border-b border-zinc-200">
    <!-- Ambient Architectural Grid & Dynamic Atmospheric Glows -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-0 bg-blueprint-grid opacity-75"></div>
      <div class="absolute inset-0 bg-tactical-grid opacity-40"></div>
      <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-emerald-200/35 blur-3xl"></div>
      <div class="absolute top-1/3 -right-32 w-[32rem] h-[32rem] rounded-full bg-amber-100/40 blur-3xl"></div>
      <div class="absolute bottom-1/4 -left-20 w-80 h-80 rounded-full bg-emerald-100/30 blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20 relative z-10">
      
      <!-- Primary Core Statement Banner (Matching exact user specifications) -->
      <div class="p-8 sm:p-12 lg:p-14 rounded-3xl bg-white/95 backdrop-blur-xl border border-zinc-200/90 shadow-lg space-y-8">
        <div class="max-w-4xl space-y-3">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-900 border border-emerald-200 text-xs font-semibold uppercase tracking-wider shadow-xs">
            Direct Material Supply &bull; Surathkal Workshop
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 font-heading leading-tight tracking-tight">
            Premium Stainless Steel <span class="text-gradient-bronze">Railing Materials</span>
          </h1>
          <p class="text-lg sm:text-xl text-zinc-800 font-medium leading-relaxed">
            We specialize in all types of premium <strong class="text-emerald-900 font-bold">SS 304 Grade Railing Pipes and Fittings</strong>, available in:
          </p>
        </div>

        <!-- 4 Core Available Types with Matching Dedicated Pictures -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {salesCategories.slice(0, 4).map((cat, idx) => (
            <a
              href={`#${cat.id}`}
              class="group relative rounded-2xl bg-zinc-50 border border-zinc-200/90 hover:border-emerald-500 overflow-hidden shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col"
            >
              <div class="relative aspect-[4/3] w-full overflow-hidden bg-zinc-100">
                <img
                  src={cat.image}
                  alt={cat.alt}
                  width="400"
                  height="300"
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute top-2.5 left-2.5 px-2.5 py-1 rounded-full bg-zinc-950/80 backdrop-blur-md text-white text-[11px] font-semibold border border-white/10">
                  0{idx + 1}
                </div>
              </div>
              <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
                <div>
                  <h3 class="text-base font-bold text-zinc-900 group-hover:text-emerald-800 font-heading transition-colors">
                    {cat.name}
                  </h3>
                  <p class="text-xs text-zinc-600 line-clamp-2 mt-1 leading-relaxed">
                    {cat.subtitle}
                  </p>
                </div>
                <div class="pt-2 flex items-center text-xs font-semibold text-emerald-800 group-hover:translate-x-0.5 transition-transform">
                  <span>View Details &amp; Sizes</span>
                  <span class="ml-1">&rarr;</span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Hallmark Quality Assurance Banner (Exact user phrase) -->
        <div class="p-5 sm:p-6 rounded-2xl bg-gradient-to-r from-emerald-50/90 via-zinc-50 to-amber-50/40 border border-emerald-200/80 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-start sm:items-center gap-3">
            <span class="text-2xl shrink-0">✨</span>
            <div class="space-y-0.5">
              <div class="text-xs font-bold text-emerald-900 uppercase tracking-wider">Quality Assurance</div>
              <p class="text-sm sm:text-base font-bold text-zinc-900 leading-snug">
                High-quality 304 Grade Stainless Steel – Elegant Finish, Superior Corrosion Resistance, and Long-lasting Durability.
              </p>
            </div>
          </div>
          <a
            href="#ss-fittings"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white border border-emerald-300 text-emerald-900 text-xs font-bold hover:bg-emerald-50 transition-colors shrink-0 shadow-xs"
          >
            <span>+ View SS 304 Fittings</span>
            <span>&darr;</span>
          </a>
        </div>
      </div>

      <!-- Detailed Categories List (Hero Photography + Specs) -->
      <div class="space-y-20">
        {salesCategories.map((cat, idx) => (
          <div
            id={cat.id}
            class="scroll-mt-36 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center p-6 sm:p-8 rounded-3xl bg-white/95 backdrop-blur-xl border border-zinc-200/90 hover:border-emerald-400 hover:shadow-[0_20px_45px_-12px_rgba(5,150,105,0.14)] transition-all duration-300 shadow-md"
          >
            <!-- Visual Card (7 Cols) - Prominent Hero Product Photo -->
            <div class:list={['lg:col-span-7 space-y-3', idx % 2 === 1 ? 'lg:order-2' : '']}>
              <div class="relative aspect-[16/10] rounded-2xl overflow-hidden border border-zinc-200 bg-zinc-100 shadow-xl group">
                <img
                  src={cat.image}
                  alt={cat.alt}
                  width="1200"
                  height="750"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <!-- Lightbox Zoom Trigger -->
                <button
                  type="button"
                  data-lightbox-trigger
                  data-type="image"
                  data-image={cat.image}
                  data-title={cat.name}
                  data-description={cat.description}
                  data-location="Needs Group Surathkal Workshop"
                  class="absolute top-3 right-3 p-2.5 rounded-xl bg-zinc-950/70 hover:bg-zinc-950/90 text-white border border-white/20 backdrop-blur-md transition-all shadow-md"
                  title="Expand Full Photo"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </button>
                <div class="absolute bottom-3 left-3 px-3 py-1 rounded-full bg-zinc-950/80 backdrop-blur-md text-white text-xs font-semibold border border-white/10">
                  {cat.badge}
                </div>
              </div>
              <!-- Spec Bar -->
              <div class="p-3.5 rounded-xl bg-zinc-50 border border-zinc-200 text-xs text-zinc-700 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <div><span class="text-emerald-800 font-bold">Specifications:</span> {cat.specs}</div>
                <span class="text-zinc-400 text-[11px] shrink-0">Genuine SS 304</span>
              </div>
            </div>

            <!-- Content Details (5 Cols) -->
            <div class:list={['lg:col-span-5 space-y-5', idx % 2 === 1 ? 'lg:order-1' : '']}>
              <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-semibold uppercase tracking-wider shadow-sm">
                  0{idx + 1} • SS 304 Material
                </div>
                <h3 class="text-2xl sm:text-3xl font-bold text-zinc-900 font-heading">
                  {cat.name}
                </h3>
                <p class="text-sm font-semibold text-emerald-800">
                  {cat.subtitle}
                </p>
              </div>

              <p class="text-zinc-600 text-sm leading-relaxed">
                {cat.description}
              </p>

              <!-- Key Highlights Checklist -->
              <div class="space-y-2">
                <div class="text-xs font-bold text-zinc-900 uppercase tracking-wider">Product Highlights:</div>
                <div class="space-y-1.5 text-xs text-zinc-700">
                  {cat.highlights.map((h) => (
                    <div class="flex items-start gap-2 bg-zinc-50/80 p-2.5 rounded-lg border border-zinc-200/80">
                      <span class="text-emerald-600 font-bold shrink-0">✓</span>
                      <span>{h}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Applications -->
              <div class="pt-2 border-t border-zinc-200 space-y-1">
                <div class="text-xs font-bold text-zinc-500 uppercase tracking-wider">Recommended Applications:</div>
                <ul class="text-xs text-zinc-600 list-disc list-inside space-y-0.5">
                  {cat.bestUseCases.map((u) => (
                    <li>{u}</li>
                  ))}
                </ul>
              </div>

              <!-- Action Buttons -->
              <div class="pt-3 flex flex-wrap gap-3">
                <button
                  type="button"
                  data-open-whatsapp
                  data-service={`Material Price Inquiry: ${cat.name}`}
                  class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-emerald-700 via-emerald-600 to-emerald-800 hover:scale-[1.02] text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
                  <span>Inquire for {cat.name.split(' (')[0].trim()}</span>
                </button>
                <a
                  href="/contact/#enquiry-form"
                  class="inline-flex items-center gap-1.5 px-5 py-3 rounded-full bg-white border border-zinc-200 text-zinc-800 text-xs font-semibold hover:border-emerald-400 uppercase tracking-wider transition-colors shadow-sm"
                >
                  <span>Request Custom Quote</span>
                </a>
              </div>

            </div>
          </div>
        ))}
      </div>

      <!-- Custom Material Cutting & BOQ Note -->
      <div class="p-8 sm:p-12 rounded-3xl bg-zinc-900 text-white space-y-6">
        <div class="max-w-3xl space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-700/60 text-emerald-300 text-xs font-semibold uppercase tracking-wider">
            Custom Stainless Steel Cutting &amp; Profiling
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold font-heading">
            Need Pipes Cut to Exact Staircase &amp; Balcony Lengths?
          </h3>
          <p class="text-zinc-300 text-sm sm:text-base leading-relaxed">
            Avoid on-site metal cutting noise, jagged edges, and material wastage. Send us your railing cut-list or architectural blueprint. We will precision cold-cut, miter, deburr, and bundle your SS 304 round, square, or slotted pipes ready for immediate bolting or welding.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <button
            type="button"
            data-open-whatsapp
            data-service="SS 304 Pipe Cut List & Material BOQ"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-md"
          >
