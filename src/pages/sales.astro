---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import CTABanner from '../components/CTABanner.astro';
import { mediaManifest } from '../data/media';

const bannerVideo = mediaManifest.banners.construction;

// Initial category placeholders ready for exact client specifications
const productCategories = [
  {
    id: 'ss-pipes',
    title: 'Stainless Steel Pipes & Tubes',
    subtitle: 'Grade 304 & Marine-Grade 316',
    description: 'High-purity stainless steel tubular and rectangular profiles with mirror-polish and satin hairline finishes, ideal for coastal balustrades, gates, and interior fabrication.',
    highlights: [
      'Round Pipes (16mm to 76mm OD)',
      'Square & Rectangular Box Tubes (12x12mm to 100x50mm)',
      'Slotted Handrail Profiles for Frameless Glass',
      'Tested for coastal saline corrosion resistance',
    ],
    badge: 'SS 304 / SS 316',
    icon: 'pipe',
  },
  {
    id: 'gi-structural',
    title: 'Galvanized Iron (GI) & Structural Steel',
    subtitle: 'Heavy-Gauge Hollow Sections & Flats',
    description: 'Hot-dip galvanized box sections, purlins, MS channels, angles, and heavy structural tubes designed for enduring structural support and perimeter security.',
    highlights: [
      'Square & Rectangular GI Hollow Sections (RHS / SHS)',
      'Mild Steel (MS) Angles, Channels & Beams (ISMB / ISMC)',
      'Galvanized Flat Bars & Solid Square Rods',
      'Uniform zinc coating with high tensile yield strength',
    ],
    badge: 'Heavy Hot-Dip GI',
    icon: 'structural',
  },
  {
    id: 'railing-hardware',
    title: 'Architectural Railing Hardware & Glass Fittings',
    subtitle: 'Precision Cast Stainless Steel Components',
    description: 'Architectural-grade glass clamps, continuous aluminium/SS base shoe channels, solid spigots, handrail wall brackets, and articulated spider fittings.',
    highlights: [
      'Solid Base Shoe U-Channels for Frameless Glass',
      'Surface & Core-Drill Spigots for Toughened Glass',
      'Articulated Spider Fittings & Routels (SS 316)',
      'Wall Brackets, Elbows, End-Caps & Connectors',
    ],
    badge: 'Architectural Hardware',
    icon: 'hardware',
  },
  {
    id: 'fabrication-supplies',
    title: 'Fabrication Consumables & Fasteners',
    subtitle: 'Workshop Accessories & Installation Kits',
    description: 'Comprehensive installation hardware, anchor fasteners, cutting and grinding wheels, TIG/MIG welding accessories, and mirror buffing compounds.',
    highlights: [
      'High-Tensile SS 304/316 Anchor Fasteners',
      'TIG Argon Welding Wire & Electrodes',
      'Fiber Cut-Off Wheels & Flap Discs',
      'Industrial Stainless Steel Buffing Compounds & Wheels',
    ],
    badge: 'Consumables & Tools',
    icon: 'tools',
  },
];

const perks = [
  {
    title: 'Wholesale & Retail',
    description: 'From individual piece orders for home renovations to bulk contractor consignments with competitive trade pricing.',
  },
  {
    title: 'Custom Cut-to-Length',
    description: 'In-house workshop cutting, mitering, and deburring available so your materials arrive ready for immediate installation.',
  },
  {
    title: 'Verified Metallurgy',
    description: 'Direct manufacturer sourcing from trusted brands with genuine grade testing (SS 304, SS 316, certified GI).',
  },
  {
    title: 'Coastal Delivery',
    description: 'Prompt transport and site drop-offs across Surathkal, Mangaluru, Baikampady, Mulki, and Udupi.',
  },
];
---

<Layout
  title="Pipes, Metals & Fabrication Supplies Sales – Surathkal & Mangaluru"
  description="Wholesale and retail supplier of stainless steel pipes, GI hollow sections, structural steel, glass railing hardware, and fabrication materials at Needs Group, Surathkal."
  videoSchema={{
    name: bannerVideo.title,
    description: bannerVideo.description,
    thumbnailUrl: bannerVideo.poster,
    uploadDate: bannerVideo.uploadDate,
    contentUrl: bannerVideo.mp4,
  }}
>
  <!-- Page Banner -->
  <PageBanner
    title="Pipes, Metals & Fabrication Materials Supply"
    subtitle="Wholesale & retail supply of certified stainless steel pipes, structural GI sections, railing fittings, and workshop supplies for builders, fabricators, and property owners across coastal Karnataka."
    badge="DIRECT MATERIAL SUPPLY"
    video={bannerVideo}
    breadcrumbs={[{ label: 'Sales & Supplies' }]}
    serviceName="Material & Pipe Supply Inquiry"
  />

  <!-- Main Materials Catalog Section -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Section Header -->
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-900 border border-emerald-200 text-xs font-semibold uppercase tracking-wider shadow-sm">
          Wholesale &amp; Retail Supply
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 font-heading">
          Certified Architectural Metals &amp; <span class="text-gradient-bronze">Fabrication Hardware</span>
        </h2>
        <p class="text-zinc-600 text-base leading-relaxed">
          In addition to custom turnkey fabrication, Needs Group stocks and supplies premium-grade pipes, steel sections, and railing accessories directly from our Surathkal workshop. Whether you need single lengths for a residential renovation or full truckloads for commercial projects, we deliver tested materials suited for coastal weather.
        </p>
      </div>

      <!-- Key Service Perks Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {perks.map((perk) => (
          <div class="p-6 rounded-2xl bg-zinc-50 border border-zinc-200 shadow-sm space-y-2">
            <div class="w-8 h-8 rounded-xl bg-emerald-100/70 border border-emerald-200 text-emerald-800 flex items-center justify-center font-bold text-sm mb-3">
              ✓
            </div>
            <h3 class="text-base font-bold text-zinc-900 font-heading">{perk.title}</h3>
            <p class="text-xs text-zinc-600 leading-relaxed">{perk.description}</p>
          </div>
        ))}
      </div>

      <!-- Categories Cards Grid -->
      <div class="space-y-8">
        <div class="flex items-center justify-between border-b border-zinc-200 pb-4">
          <div>
            <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 font-heading">Product Categories</h3>
            <p class="text-xs text-zinc-500 mt-1">Available for immediate workshop pickup or site dispatch</p>
          </div>
          <button
            type="button"
            data-open-whatsapp
            data-service="Material Price List Request"
            class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold hover:bg-emerald-100 transition-colors shadow-sm"
          >
            <span>Request Price List</span>
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {productCategories.map((cat) => (
            <div
              id={cat.id}
              class="p-6 sm:p-8 rounded-3xl bg-zinc-50 border border-zinc-200 hover:border-emerald-300 transition-all duration-300 shadow-sm flex flex-col justify-between space-y-6"
            >
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100/80 text-emerald-900 border border-emerald-200">
                    {cat.badge}
                  </span>
                  <span class="text-xs text-zinc-400 font-medium">In Stock</span>
                </div>

                <div>
                  <h4 class="text-xl sm:text-2xl font-bold text-zinc-900 font-heading">
                    {cat.title}
                  </h4>
                  <p class="text-xs font-semibold text-emerald-800 mt-1">
                    {cat.subtitle}
                  </p>
                </div>

                <p class="text-sm text-zinc-600 leading-relaxed">
                  {cat.description}
                </p>

                <!-- Product Specifications Checklist -->
                <div class="pt-3 border-t border-zinc-200/80 space-y-2">
                  <div class="text-xs font-bold text-zinc-700 uppercase tracking-wider">Common Specifications:</div>
                  <ul class="grid grid-cols-1 gap-1.5 text-xs text-zinc-600">
                    {cat.highlights.map((item) => (
                      <li class="flex items-start gap-2">
                        <span class="text-emerald-700 font-bold shrink-0 mt-0.5">•</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Quick Quote Action for This Category -->
              <div class="pt-4 border-t border-zinc-200/80 flex flex-wrap items-center gap-3">
                <button
                  type="button"
                  data-open-whatsapp
                  data-service={`Sales Inquiry: ${cat.title}`}
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-sm"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
                  <span>Inquire for {cat.title.split(' (')[0].split('&')[0].trim()}</span>
                </button>
                <a
                  href="/contact/#enquiry-form"
                  class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-white border border-zinc-200 text-zinc-800 text-xs font-semibold hover:border-emerald-300 uppercase tracking-wider transition-colors shadow-sm"
                >
                  <span>Request BOQ Quote</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Custom Material Cutting & BOQ Note -->
      <div class="p-8 sm:p-10 rounded-3xl bg-zinc-900 text-white space-y-6">
        <div class="max-w-3xl space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-700/60 text-emerald-300 text-xs font-semibold uppercase tracking-wider">
            Bill of Quantities (BOQ) Support
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold font-heading">
            Have a Specific Cut List or Material Schedule?
          </h3>
          <p class="text-zinc-300 text-sm sm:text-base leading-relaxed">
            Send us your architectural drawings, cut list, or pipe schedules. Our workshop estimators will calculate exact material lengths, bundle quantities, and optimal cut plans to minimize site wastage and save you money.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <button
            type="button"
            data-open-whatsapp
            data-service="Custom Pipe Cut List & Material BOQ"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-md"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
            <span>Send Cut List on WhatsApp</span>
          </button>
          <a
            href="/contact/"
            class="inline-flex items-center gap-1.5 px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white text-xs font-semibold uppercase tracking-wider transition-colors"
          >
            <span>Visit Surathkal Workshop</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA Banner -->
  <CTABanner
    title="Need Wholesale Pricing for an Upcoming Project?"
    subtitle="Reach out with your required dimensions, pipe wall thicknesses, and quantities. We deliver direct to site across coastal Karnataka."
    serviceName="Wholesale Pipe & Material Supply"
  />
</Layout>
